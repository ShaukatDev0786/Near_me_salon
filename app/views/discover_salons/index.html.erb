<div class="min-h-screen bg-slate-50">
  <!-- Page Header -->
  <section class="relative overflow-hidden bg-gradient-to-br from-violet-700 via-purple-700 to-indigo-800">
    <div class="absolute -right-20 -top-24 h-80 w-80 rounded-full bg-white/10 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-20 h-80 w-80 rounded-full bg-fuchsia-400/10 blur-3xl"></div>

    <div class="relative mx-auto max-w-7xl px-5 py-12 sm:px-8 sm:py-16">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium text-white">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Your local beauty destination
        </span>

        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
          Find Your Perfect
          <span class="block text-violet-200">Salon Nearby.</span>
        </h1>

        <p class="mt-5 max-w-2xl text-base leading-7 text-violet-100 sm:text-lg">
          Discover trusted salons around you, explore their services, and book
          your next appointment with ease.
        </p>
      </div>
    </div>
  </section>

  <!-- Search Section -->
  <section class="relative z-10 mx-auto -mt-7 max-w-7xl px-5 sm:px-8">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xl shadow-slate-200/60 sm:p-7">
      <div class="mb-5">
        <h2 class="text-lg font-bold text-slate-900 sm:text-xl">
          Find salons in your area
        </h2>
        <p class="mt-1 text-sm text-slate-500">
          Enter your city or PIN code to get started.
        </p>
      </div>

      <%= form_with url: salons_path, method: :get, local: true, id: "salon-search-form", class: "grid grid-cols-1 gap-4 md:grid-cols-[1fr_1fr_auto] md:items-end" do |form| %>

        <div>
          <%= form.label :city, "City",
              class: "mb-2 block text-sm font-semibold text-slate-700" %>

          <div class="relative">
            <svg class="pointer-events-none absolute left-3.5 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>

            <%= form.text_field :city,
                value: params[:city],
                placeholder: "e.g. Lucknow",
                class: "w-full rounded-xl border border-slate-200 bg-slate-50 py-3.5 pl-11 pr-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-violet-500 focus:bg-white focus:ring-4 focus:ring-violet-100" %>
          </div>
        </div>

        <div>
          <%= form.label :pincode, "PIN Code",
              class: "mb-2 block text-sm font-semibold text-slate-700" %>

          <div class="relative">
            <svg class="pointer-events-none absolute left-3.5 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 21s7-4.5 7-11a7 7 0 10-14 0c0 6.5 7 11 7 11z" />
              <circle cx="12" cy="10" r="2.5" stroke-width="2" />
            </svg>

            <%= form.text_field :pincode,
                value: params[:pincode],
                placeholder: "e.g. 226001",
                class: "w-full rounded-xl border border-slate-200 bg-slate-50 py-3.5 pl-11 pr-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-violet-500 focus:bg-white focus:ring-4 focus:ring-violet-100" %>
          </div>
        </div>

        <div>
          <%= form.button type: "submit",
              class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-violet-600 px-7 py-3.5 text-sm font-bold text-white shadow-lg shadow-violet-200 transition hover:-translate-y-0.5 hover:bg-violet-700 hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-violet-200 md:w-auto" do %>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="7" stroke-width="2" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m16 16 4 4" />
            </svg>
            Search Salons
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Salon Results -->
  <section id="available-salons" class="scroll-mt-24 mx-auto max-w-7xl px-5 py-12 sm:px-8 sm:py-14">
    <div class="mb-7 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-violet-600">
          Explore nearby
        </p>
        <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
          Available Salons
        </h2>
        <p class="mt-2 text-sm text-slate-500">
          Choose a salon and discover the services it offers.
        </p>
      </div>

      <div class="inline-flex w-fit items-center gap-2 rounded-full bg-violet-50 px-4 py-2 text-sm font-semibold text-violet-700">
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        <%= pluralize(@salons.size, "salon") %> found
      </div>
    </div>

    <% if @salons.any? %>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
        <% @salons.each do |salon| %>
          <article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-violet-200 hover:shadow-xl hover:shadow-violet-100/60">
            <!-- Card Accent -->
            <div class="h-1.5 bg-gradient-to-r from-violet-500 via-purple-500 to-fuchsia-500"></div>

            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-start gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-violet-100 to-fuchsia-100 text-violet-700">
                  <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"
                      d="M4 21h16M5 21V7l7-4 7 4v14M9 10h1m4 0h1m-6 4h1m4 0h1m-5 7v-4h2v4" />
                  </svg>
                </div>

                <div class="min-w-0 flex-1">
                  <h3 class="break-words text-xl font-bold text-slate-900 transition group-hover:text-violet-700">
                    <%= salon.name %>
                  </h3>

                  <p class="mt-2 flex items-center gap-1.5 text-sm text-slate-500">
                    <svg class="h-4 w-4 shrink-0 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span class="break-words"><%= salon.city %> — <%= salon.pincode %></span>
                  </p>
                </div>
              </div>

              <p class="mt-5 min-h-12 text-sm leading-6 text-slate-600">
                <%= salon.description.presence || "Discover our salon and explore the services available for you." %>
              </p>

              <div class="mt-5 flex items-center justify-between gap-3 border-t border-slate-100 pt-4">
                <div class="flex items-center gap-2 text-sm text-slate-600">
                  <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-50 text-violet-600">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                  </span>
                  <span class="font-medium">
                    <%= pluralize(salon.services.where(active: true).count, "active service") %>
                  </span>
                </div>

                <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
                  Available
                </span>
              </div>

              <div class="mt-6">
                <%= link_to salon_path(salon),
                    class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white transition hover:bg-violet-600 focus:outline-none focus:ring-4 focus:ring-violet-100" do %>
                  View Salon & Services
                  <svg class="h-4 w-4 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6" />
                  </svg>
                <% end %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center sm:px-12">
        <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-violet-50 text-violet-600">
          <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="7" stroke-width="1.8" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m16 16 4 4" />
          </svg>
        </div>

        <h3 class="mt-6 text-xl font-bold text-slate-900">
          No salons found
        </h3>

        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
          We couldn't find any salons matching your search. Try another city or PIN code to discover more options.
        </p>

        <%= link_to "Explore All Salons",
            discover_salons_path,
            class: "mt-6 inline-flex items-center justify-center rounded-xl bg-violet-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-violet-700 focus:outline-none focus:ring-4 focus:ring-violet-100" %>
      </div>
    <% end %>
  </section>
</div>
