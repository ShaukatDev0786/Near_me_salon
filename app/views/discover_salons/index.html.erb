
<div class="mx-auto max-w-5xl p-6">
  <h1 class="mb-2 text-3xl font-bold">Find Salons Near You</h1>
  <p class="mb-6 text-gray-600">
    Search salons by city or PIN code.
  </p>

  <%= form_with url: search_salons_path, method: :get,
      class: "mb-8 grid gap-4 sm:grid-cols-3" do |form| %>
    <div>
      <%= form.label :city, "City" %>
      <%= form.text_field :city, value: params[:city],
          placeholder: "e.g. Lucknow",
          class: "w-full rounded border p-2" %>
    </div>

    <div>
      <%= form.label :pincode, "PIN Code" %>
      <%= form.text_field :pincode, value: params[:pincode],
          maxlength: 6, placeholder: "e.g. 226001",
          class: "w-full rounded border p-2" %>
    </div>

    <div class="flex items-end">
      <%= form.submit "Search Salons",
          class: "w-full rounded bg-blue-600 px-4 py-2 text-white" %>
    </div>
  <% end %>

  <h2 class="mb-4 text-xl font-semibold">Available Salons</h2>

  <% if @salons.any? %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @salons.each do |salon| %>
        <div class="rounded-lg border p-5 shadow-sm">
          <h3 class="text-xl font-bold"><%= salon.name %></h3>

          <p class="mt-2 text-gray-600">
            <%= salon.city %> — <%= salon.pincode %>
          </p>

          <p class="mt-1"><%= salon.address %></p>

          <p class="mt-2">
            <%= salon.services.where(active: true).count %>
            active services
          </p>

          <%= link_to "View Salon",
              discover_salon_path(salon),
              class: "mt-4 inline-block rounded bg-blue-600 px-4 py-2 text-white" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No salons found. Try another city or PIN code.</p>
  <% end %>
</div>
