<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">

  <!-- Header -->
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-violet-600">
        Administration
      </p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">
        Salon Approvals
      </h1>
      <p class="mt-1 text-sm text-slate-500">
        Review salon registrations and manage their public availability.
      </p>
    </div>

    <%= link_to "Back to Dashboard", admin_dashboard_path,
      class: "inline-flex h-10 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
  </div>


  <!-- Salon Approval Summary -->
  <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-500">Total Salons</p>
      <p class="mt-2 text-3xl font-bold text-slate-900">
        <%= @total_salons %>
      </p>
      <p class="mt-1 text-xs text-slate-500">All registrations</p>
    </div>

    <div class="rounded-xl border border-amber-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-500">Pending Review</p>
      <p class="mt-2 text-3xl font-bold text-amber-600">
        <%= @pending_salons %>
      </p>
      <p class="mt-1 text-xs text-slate-500">Awaiting admin approval</p>
    </div>

    <div class="rounded-xl border border-emerald-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-500">Approved</p>
      <p class="mt-2 text-3xl font-bold text-emerald-600">
        <%= @approved_salons %>
      </p>
      <p class="mt-1 text-xs text-slate-500">Approved registrations</p>
    </div>

    <div class="rounded-xl border border-red-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-500">Rejected</p>
      <p class="mt-2 text-3xl font-bold text-red-600">
        <%= @rejected_salons %>
      </p>
      <p class="mt-1 text-xs text-slate-500">Rejected registrations</p>
    </div>

  </div>


  <!-- Filters -->

<!-- Search and Filters -->
<div class="mb-5 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
  <%= form_with url: admin_salons_path, method: :get,
    class: "grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4" do |form| %>

    <div class="xl:col-span-2">
      <%= form.label :search, "Search Salons",
        class: "mb-1 block text-sm font-medium text-slate-700" %>

      <%= form.search_field :search,
        value: params[:search],
        placeholder: "Salon name, owner email, city or PIN code",
        class: "h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-100" %>
    </div>

    <div>
      <%= form.label :approval_status, "Approval Status",
        class: "mb-1 block text-sm font-medium text-slate-700" %>

      <%= form.select :approval_status,
        options_for_select(
          [
            ["All salons", ""],
            ["Pending", "pending"],
            ["Approved", "approved"],
            ["Rejected", "rejected"]
          ],
          params[:approval_status]
        ),
        {},
        class: "h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-100" %>
    </div>

    <div class="flex items-end gap-2">
      <%= form.submit "Search",
        class: "inline-flex h-10 flex-1 cursor-pointer items-center justify-center rounded-lg bg-violet-600 px-4 text-sm font-semibold text-white transition hover:bg-violet-700" %>

      <%= link_to "Reset", admin_salons_path,
        class: "inline-flex h-10 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
    </div>

  <% end %>
</div>


  <!-- Salon List -->
  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
      <h2 class="font-semibold text-slate-900">Registered Salons</h2>
      <span class="text-sm text-slate-500">
        <%= @filtered_salons_count %> matching salons
      </span>
    </div>

    <% if @salons.any? %>
      <div class="divide-y divide-slate-100">
        <% @salons.each do |salon| %>
          <div class="p-4 transition hover:bg-slate-50/70">
            <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">

              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-base font-semibold text-slate-900">
                    <%= salon.name %>
                  </h3>

                  <% approval_colors = {
                    "pending" => "bg-amber-100 text-amber-800",
                    "approved" => "bg-emerald-100 text-emerald-800",
                    "rejected" => "bg-red-100 text-red-800"
                  } %>

                  <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= approval_colors.fetch(salon.approval_status, 'bg-slate-100 text-slate-700') %>">
                    <%= salon.approval_status.humanize %>
                  </span>
                </div>

                <div class="mt-3 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2 lg:grid-cols-3">
                  <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Owner</p>
                    <p class="mt-1 break-words text-slate-700"><%= salon.user.email %></p>
                  </div>

                  <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Location</p>
                    <p class="mt-1 text-slate-700"><%= salon.city %>, <%= salon.pincode %></p>
                  </div>

                  <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Registered</p>
                    <p class="mt-1 text-slate-700"><%= salon.created_at.strftime("%d %b %Y") %></p>
                  </div>
                </div>
              </div>

              <div class="flex flex-wrap items-center gap-2">
                <% if salon.approval_status != "approved" %>
                  <%= button_to "Approve",
                    approve_admin_salon_path(salon),
                    method: :patch,
                    class: "inline-flex h-9 items-center justify-center rounded-lg bg-emerald-600 px-4 text-sm font-semibold text-white hover:bg-emerald-700",
                    form: { data: { turbo_confirm: "Approve #{salon.name}?" } } %>
                <% end %>

                <% if salon.approval_status != "rejected" %>
                  <%= button_to "Reject",
                    reject_admin_salon_path(salon),
                    method: :patch,
                    class: "inline-flex h-9 items-center justify-center rounded-lg bg-red-600 px-4 text-sm font-semibold text-white hover:bg-red-700",
                    form: { data: { turbo_confirm: "Reject #{salon.name}?" } } %>
                <% end %>
              </div>

            </div>
          </div>
        <% end %>
      </div>

      <div class="border-t border-slate-200 px-4 py-3">
        <%= paginate @salons, params: request.query_parameters %>
      </div>
    <% else %>
      <div class="px-5 py-12 text-center">
        <h3 class="text-base font-semibold text-slate-900">No salons found</h3>
        <p class="mt-1 text-sm text-slate-500">
          Try another approval status or check again later.
        </p>
      </div>
    <% end %>
  </div>

</div>
