<%= form_with model: salon, class: "space-y-4" do |form| %>
  <% if salon.errors.any? %>
    <div class="rounded border border-red-300 p-3 text-red-700">
      <h2>Please correct these errors:</h2>
      <ul class="list-disc pl-5">
        <% salon.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Salon Name" %>
    <%= form.text_field :name, required: true,
        class: "w-full rounded border p-2" %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description,
        class: "w-full rounded border p-2" %>
  </div>

  <div>
    <%= form.label :phone, "Contact Number" %>
    <%= form.telephone_field :phone, required: true,
        class: "w-full rounded border p-2" %>
  </div>

  <div>
    <%= form.label :address %>
    <%= form.text_field :address, required: true,
        class: "w-full rounded border p-2" %>
  </div>

  <div>
    <%= form.label :city %>
    <%= form.text_field :city, required: true,
        class: "w-full rounded border p-2" %>
  </div>

  <div>
    <%= form.label :pincode, "PIN Code" %>
    <%= form.text_field :pincode, required: true,
        maxlength: 6, class: "w-full rounded border p-2" %>
  </div>

  <%= form.submit class: "rounded bg-blue-600 px-4 py-2 text-white" %>
<% end %>
