<div class="min-h-screen bg-slate-50">
  <!-- Page Header -->
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-5 py-8 sm:px-8 sm:py-10">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-violet-600">
            Salon management
          </p>

          <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
            My Salons
          </h1>

          <p class="mt-2 text-sm leading-6 text-slate-500">
            Manage your salon profiles, locations, and details in one place.
          </p>
        </div>

        <%= link_to new_salon_path,
            class: "inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white shadow-md shadow-violet-200 transition duration-200 hover:-translate-y-0.5 hover:bg-violet-700 hover:shadow-lg focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-violet-300 active:translate-y-0 active:scale-[0.98]" do %>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m-7-7h14"/>
          </svg>
          Add Salon
        <% end %>
      </div>
    </div>
  </section>

  <!-- Salon List -->
  <section class="mx-auto max-w-7xl px-5 py-8 sm:px-8 sm:py-10">
    <div class="mb-6 flex items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-slate-900">Your Salon Profiles</h2>
        <p class="mt-1 text-sm text-slate-500">
          View and update the salons you manage.
        </p>
      </div>

      <span class="inline-flex shrink-0 items-center rounded-full bg-violet-50 px-3 py-1.5 text-sm font-semibold text-violet-700">
        <%= pluralize(@salons.size, "salon") %>
      </span>
    </div>

    <!-- My Salon Locations -->
    <% if @salons.any? %>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        <% @salons.each do |salon| %>
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg">

            <div class="h-1.5 bg-gradient-to-r from-violet-500 to-fuchsia-500"></div>

            <div class="p-5">
              <div class="mb-3 flex items-start justify-between gap-3">
                <h3 class="text-lg font-bold text-slate-900">
                  <%= salon.name %>
                </h3>

                <% if salon.approval_status == "approved" %>
                  <span class="shrink-0 rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700">
                    Approved
                  </span>
                <% elsif salon.approval_status == "rejected" %>
                  <span class="shrink-0 rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700">
                    Rejected
                  </span>
                <% else %>
                  <span class="shrink-0 rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700">
                    Pending Approval
                  </span>
                <% end %>
              </div>

              <div class="mb-3 flex items-center gap-2 text-sm text-slate-500">
                <span class="text-violet-600">📍</span>
                <span><%= salon.city %> — <%= salon.pincode %></span>
              </div>

              <p class="mb-4 min-h-12 text-sm leading-6 text-slate-500"
                style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                <%= salon.description.presence || "No salon description added yet." %>
              </p>

              <div class="mb-4 rounded-xl bg-slate-50 p-3">
                <div class="mb-1 flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-slate-400">
                  <span>⌂</span>
                  Address
                </div>
                <p class="text-sm text-slate-700">
                  <%= salon.address %>
                </p>
              </div>

              <div class="mb-5 rounded-xl bg-violet-50 p-3">
                <p class="text-sm text-slate-600">Total Services</p>
                <p class="mt-1 text-2xl font-bold text-slate-900">
                  <%= salon.services.size %>
                </p>
              </div>

              <div class="flex flex-col gap-2">
                <%= link_to "Manage Salon", edit_salon_path(salon),
                    class: "rounded-lg border border-violet-200 px-4 py-2.5 text-center text-sm font-semibold text-violet-700 transition hover:bg-violet-50" %>

                <%= link_to "View Services", salon_services_path(salon),
                    class: "rounded-lg border border-violet-200 px-4 py-2.5 text-center text-sm font-semibold text-violet-700 transition hover:bg-violet-50" %>

                <%= link_to "Add Service", new_salon_service_path(salon),
                    class: "rounded-lg bg-violet-600 px-4 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-violet-700" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
        <h3 class="text-lg font-semibold text-slate-900">No salons registered yet</h3>
        <p class="mt-2 text-sm text-slate-500">
          Add your first salon to start managing its services.
        </p>
        <%= link_to "Add Salon", new_salon_path,
            class: "mt-4 inline-block rounded-lg bg-violet-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-violet-700" %>
      </div>
    <% end %>

  </section>
</div>
