<div class="mx-auto max-w-2xl p-6">
  <h1 class="text-3xl font-bold"><%= @salon.name %></h1>

  <p class="mt-3"><%= @salon.description %></p>
  <p class="mt-2">Phone: <%= @salon.phone %></p>
  <p class="mt-2">Address: <%= @salon.address %></p>
  <p class="mt-2">City: <%= @salon.city %></p>
  <p class="mt-2">PIN Code: <%= @salon.pincode %></p>

  <div class="mt-6 flex gap-4">
    <%= link_to "Edit", edit_salon_path(@salon),
        class: "text-blue-600" %>

    <%= link_to "Back to My Salons", salons_path,
        class: "text-blue-600" %>
  </div>

  <%= link_to "Manage Services", salon_services_path(@salon), class: "text-blue-600" %>

</div>
