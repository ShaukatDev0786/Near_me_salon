<header class="sticky top-0 z-50 border-b border-gray-200 bg-white shadow-sm">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-6 py-3">
    <%= link_to "NearMe Salon", root_path,
        class: "text-2xl font-bold text-indigo-600" %>

    <nav class="flex flex-wrap items-center gap-3">
      <%= link_to "Services", root_path(anchor: "services"),
          class: "text-sm text-gray-600 hover:text-indigo-600" %>

      <%= link_to "How it works", root_path(anchor: "how-it-works"),
          class: "text-sm text-gray-600 hover:text-indigo-600" %>

      <%= link_to "Find Salons", search_salons_path,
          class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>

      <% if user_signed_in? %>
        <% if current_user.customer? %>
          <%= link_to "My Appointments", appointments_path,
              class: "rounded-lg border border-indigo-600 px-4 py-2 text-sm font-semibold text-indigo-600 hover:bg-indigo-50" %>

        <% elsif current_user.salon_owner? %>
          <%= link_to "My Salons", salons_path,
              class: "rounded-lg border border-indigo-600 px-4 py-2 text-sm font-semibold text-indigo-600 hover:bg-indigo-50" %>

          <%= link_to "Manage Appointments", salon_owner_appointments_path,
              class: "rounded-lg border border-indigo-600 px-4 py-2 text-sm font-semibold text-indigo-600 hover:bg-indigo-50" %>

        <% elsif current_user.admin? %>
          <%= link_to "Admin Dashboard", admin_dashboard_path,
              class: "rounded-lg border border-indigo-600 px-4 py-2 text-sm font-semibold text-indigo-600 hover:bg-indigo-50" %>
        <% end %>

        <%= button_to "Logout",
            destroy_user_session_path,
            method: :delete,
            class: "rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700" %>

      <% else %>
        <%= link_to "Login", new_user_session_path,
            class: "rounded-lg px-4 py-2 text-sm text-gray-700 hover:text-indigo-600" %>

        <%= link_to "Sign Up", new_user_registration_path,
            class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
      <% end %>
    </nav>
  </div>
</header>
