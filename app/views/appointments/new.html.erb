
<div class="mx-auto max-w-2xl p-6">
  <h1 class="mb-2 text-2xl font-bold">Book an Appointment</h1>
  <p class="mb-6 text-gray-600"><%= @salon.name %></p>

  <%= form_with model: [@salon, @appointment],
      class: "space-y-4" do |form| %>

    <% if @appointment.errors.any? %>
      <div class="rounded border border-red-300 p-3 text-red-700">
        <ul class="list-disc pl-5">
          <% @appointment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :service_id, "Choose a service" %>
      <%= form.collection_select :service_id, @services, :id, :name,
          { prompt: "Select a service" },
          { required: true, class: "w-full rounded border p-2" } %>
    </div>

    <div>
      <%= form.label :appointment_at, "Date and time" %>
      <%= form.datetime_local_field :appointment_at,
          required: true,
          min: Time.current.strftime("%Y-%m-%dT%H:%M"),
          class: "w-full rounded border p-2" %>
    </div>

    <div>
      <%= form.label :notes, "Additional notes (optional)" %>
      <%= form.text_area :notes,
          rows: 3,
          class: "w-full rounded border p-2" %>
    </div>

    <%= form.submit "Book Appointment",
        class: "rounded bg-blue-600 px-4 py-2 text-white" %>
  <% end %>

  <%= link_to "Back to Salon",
      discover_salon_path(@salon),
      class: "mt-4 inline-block text-blue-600" %>
</div>
