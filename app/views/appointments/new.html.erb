<div class="min-h-screen bg-slate-50">
  <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:py-12">

    <!-- Page Header -->
    <div class="mb-6">
      <%= link_to discover_salon_path(@salon),
          class: "inline-flex items-center gap-2 text-sm font-semibold text-violet-700 transition hover:text-violet-900" do %>
        <span aria-hidden="true">←</span>
        Back to Salon
      <% end %>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="h-2 bg-gradient-to-r from-violet-600 via-purple-500 to-fuchsia-500"></div>

      <div class="p-6 sm:p-8">
        <div class="flex items-start gap-4">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-violet-50 text-3xl">
            📅
          </div>

          <div>
            <p class="text-sm font-semibold uppercase tracking-widest text-violet-600">
              Reserve Your Visit
            </p>
            <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
              Book an Appointment
            </h1>
            <p class="mt-2 font-medium text-slate-600">
              <%= @salon.name %>
            </p>
            <p class="mt-1 text-sm text-slate-500">
              Choose your service and preferred appointment time.
            </p>
          </div>
        </div>

        <div class="my-7 border-t border-slate-100"></div>

        <%= form_with model: [@salon, @appointment], class: "space-y-6" do |form| %>

          <% if @appointment.errors.any? %>
            <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-red-800">
              <h2 class="font-semibold">
                Please check the following details:
              </h2>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
                <% @appointment.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <!-- Service -->
          <div>
            <h2 class="mb-3 text-sm font-semibold text-slate-800">
              Selected Services
            </h2>

            <% if @selected_services.any? %>
              <div class="space-y-3">
                <% @selected_services.each do |service| %>
                  <%= hidden_field_tag "service_ids[]", service.id %>

                  <div class="flex items-center justify-between gap-4 rounded-xl border border-slate-200 bg-slate-50 p-4">
                    <div>
                      <p class="font-semibold text-slate-900"><%= service.name %></p>
                      <p class="mt-1 text-sm text-slate-500"><%= service.duration %> minutes</p>
                    </div>

                    <p class="font-bold text-violet-700">
                      <%= number_to_currency(service.price, unit: "₹", precision: 2) %>
                    </p>
                  </div>
                <% end %>
              </div>

              <div class="mt-4 rounded-xl bg-violet-50 p-4">
                <div class="flex justify-between gap-4">
                  <span class="text-sm text-slate-600">Total duration</span>
                  <span class="font-semibold text-slate-900">
                    <%
                      total_duration = @selected_services.sum { |service| service.duration.to_i }
                      hours = total_duration / 60
                      minutes = total_duration % 60
                    %>

                    <%= "#{hours} hour#{'s' if hours != 1}" if hours > 0 %><%= " " if hours > 0 && minutes > 0 %><%= "#{minutes} minute#{'s' if minutes != 1}" if minutes > 0 || hours == 0 %>
                  </span>
                </div>

                <div class="mt-2 flex justify-between gap-4">
                  <span class="text-sm text-slate-600">Total price</span>
                  <span class="text-lg font-bold text-violet-700">
                    <%= number_to_currency(@selected_services.sum { |service| service.price.to_d }, unit: "₹", precision: 2) %>
                  </span>
                </div>
              </div>
            <% else %>
              <p class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
                No services were selected. Please return to the salon page and select at least one service.
              </p>
            <% end %>
          </div>


          <!-- Appointment Date and Time -->
          <div>
            <%= form.label :appointment_at, "Preferred date and time",
                class: "mb-2 block text-sm font-semibold text-slate-800" %>

            <%= form.datetime_local_field :appointment_at,
                required: true,
                min: Time.current.strftime("%Y-%m-%dT%H:%M"),
                class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-800 shadow-sm outline-none transition focus:border-violet-500 focus:ring-4 focus:ring-violet-100" %>

            <p class="mt-2 text-xs text-slate-500">
              Choose a date and time that works for you.
            </p>
          </div>

          <!-- Notes -->
          <div>
            <%= form.label :notes, "Additional notes (optional)",
                class: "mb-2 block text-sm font-semibold text-slate-800" %>

            <%= form.text_area :notes,
                rows: 4,
                placeholder: "Any preferences or special requests for the salon?",
                class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-800 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-violet-500 focus:ring-4 focus:ring-violet-100" %>

            <p class="mt-2 text-xs text-slate-500">
              Share any information that may help the salon prepare for your visit.
            </p>
          </div>

          <!-- Submit -->
          <div class="border-t border-slate-100 pt-6">
            <%= form.submit "Book Appointment",
                class: "inline-flex w-full cursor-pointer items-center justify-center rounded-xl bg-violet-600 px-6 py-3.5 font-semibold text-white shadow-sm transition hover:bg-violet-700 focus:outline-none focus:ring-4 focus:ring-violet-200 sm:w-auto" %>

            <p class="mt-3 text-xs leading-5 text-slate-500">
              Your appointment will follow the salon's existing booking and confirmation process.
            </p>
          </div>

        <% end %>
      </div>
    </div>

    <p class="mt-6 text-center text-sm text-slate-500">
      NearMe Salon · Your next salon visit starts here
    </p>
  </div>
</div>
