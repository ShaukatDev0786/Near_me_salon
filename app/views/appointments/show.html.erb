<div class="min-h-screen bg-slate-50">
  <% status_style = case @appointment.status
     when "confirmed"
       "bg-emerald-50 text-emerald-700 ring-emerald-600/20"
     when "pending"
       "bg-amber-50 text-amber-700 ring-amber-600/20"
     when "cancelled"
       "bg-red-50 text-red-700 ring-red-600/20"
     else
       "bg-slate-100 text-slate-700 ring-slate-500/20"
     end %>

  <!-- Page Header -->
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-5xl px-5 py-8 sm:px-8 sm:py-10">
      <%= link_to appointments_path,
          class: "inline-flex items-center gap-2 text-sm font-semibold text-slate-500 transition hover:text-violet-700" do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to My Appointments
      <% end %>

      <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-violet-600">
            Booking information
          </p>
          <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
            Appointment Details
          </h1>
          <p class="mt-2 text-sm text-slate-500">
            Review your salon booking and appointment information.
          </p>
        </div>

        <span class="inline-flex w-fit items-center gap-2 rounded-full px-3 py-1.5 text-sm font-semibold capitalize ring-1 ring-inset <%= status_style %>">
          <span class="h-2 w-2 rounded-full bg-current"></span>
          <%= @appointment.status %>
        </span>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="mx-auto max-w-5xl px-5 py-8 sm:px-8 sm:py-10">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

      <!-- Main Booking Card -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm lg:col-span-2">
        <div class="h-1.5 bg-gradient-to-r from-violet-500 via-purple-500 to-fuchsia-500"></div>

        <div class="p-5 sm:p-7">
          <div class="flex items-start gap-4 border-b border-slate-100 pb-6">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-violet-100 to-fuchsia-100 text-violet-700">
              <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 21h16M5 21V7l7-4 7 4v14M9 10h1m4 0h1m-6 4h1m4 0h1m-5 7v-4h2v4"/>
              </svg>
            </div>

            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-slate-500">Your salon</p>
              <h2 class="mt-1 break-words text-xl font-bold text-slate-900">
                <%= @appointment.salon.name %>
              </h2>
              <p class="mt-1 text-sm text-slate-500">Salon booking</p>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-6 py-6 sm:grid-cols-2">
            <div class="flex items-start gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-violet-50 text-violet-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-slate-500">Selected service</p>
                <p class="mt-1 font-bold text-slate-900"><%= @appointment.service.name %></p>
                <p class="mt-1 text-sm text-slate-500">
                  <%= pluralize(@appointment.service.duration, "minute") %>
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-2.2 0-4 1-4 2.5S9.8 13 12 13s4 1 4 2.5S14.2 18 12 18m0-12v2m0 10v2m8-8a8 8 0 11-16 0 8 8 0 0116 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-slate-500">Service price</p>
                <p class="mt-1 text-xl font-extrabold text-slate-900">
                  <%= number_to_currency(@appointment.service.price, unit: "₹", precision: 2) %>
                </p>
              </div>
            </div>
          </div>

          <!-- Date and Time -->
          <div class="rounded-2xl border border-violet-100 bg-gradient-to-br from-violet-50 to-fuchsia-50 p-5 sm:p-6">
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white text-violet-600 shadow-sm">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <rect x="3" y="4" width="18" height="17" rx="2" stroke-width="1.8"/>
                  <path stroke-linecap="round" stroke-width="1.8" d="M16 2v4M8 2v4M3 10h18"/>
                </svg>
              </div>

              <div>
                <p class="text-sm font-medium text-violet-700">Appointment date & time</p>
                <p class="mt-2 text-lg font-bold text-slate-900 sm:text-xl">
                  <%= @appointment.appointment_at.strftime("%d %B %Y") %>
                </p>
                <p class="mt-1 text-base font-semibold text-slate-600">
                  <%= @appointment.appointment_at.strftime("%I:%M %p") %>
                </p>
              </div>
            </div>
          </div>

          <!-- Notes -->
          <div class="mt-6">
            <div class="flex items-center gap-2">
              <svg class="h-5 w-5 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>
              </svg>
              <h3 class="font-bold text-slate-900">Additional Notes</h3>
            </div>

            <div class="mt-3 rounded-xl border border-slate-200 bg-slate-50 p-4">
              <p class="text-sm leading-6 text-slate-600">
                <%= @appointment.notes.presence || "No additional notes were provided for this appointment." %>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Booking Summary Sidebar -->
      <aside class="h-fit rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <h3 class="text-lg font-bold text-slate-900">Booking Summary</h3>
        <p class="mt-1 text-sm text-slate-500">A quick overview of your booking.</p>

        <div class="mt-6 space-y-5">
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Booking reference</p>
            <p class="mt-1 font-bold text-slate-800">#<%= @appointment.id %></p>
          </div>

          <div class="border-t border-slate-100 pt-4">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Current status</p>
            <p class="mt-2 font-semibold capitalize text-slate-800"><%= @appointment.status %></p>
          </div>

          <div class="border-t border-slate-100 pt-4">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Service duration</p>
            <p class="mt-1 font-semibold text-slate-800">
              <%= pluralize(@appointment.service.duration, "minute") %>
            </p>
          </div>

          <div class="border-t border-slate-100 pt-4">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Total price</p>
            <p class="mt-1 text-2xl font-extrabold text-violet-700">
              <%= number_to_currency(@appointment.service.price, unit: "₹", precision: 2) %>
            </p>
          </div>
        </div>

        <%= link_to appointments_path,
            class: "mt-7 inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-700 transition hover:border-violet-200 hover:bg-violet-50 hover:text-violet-700" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to My Appointments
        <% end %>
      </aside>
    </div>
  </section>
</div>
