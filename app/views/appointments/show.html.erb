<% status_style =
  case @appointment.status
  when "confirmed"
    "bg-emerald-50 text-emerald-700 ring-emerald-600/20"
  when "pending"
    "bg-amber-50 text-amber-700 ring-amber-600/20"
  when "cancelled"
    "bg-rose-50 text-rose-700 ring-rose-600/20"
  when "completed"
    "bg-blue-50 text-blue-700 ring-blue-600/20"
  else
    "bg-slate-100 text-slate-700 ring-slate-600/20"
  end
%>

<% booked_services = @appointment.appointment_services.includes(:service) %>
<% has_multiple_service_records = booked_services.any? %>

<% total_price = if has_multiple_service_records
     booked_services.sum { |item| item.price.to_d }
   elsif @appointment.service
     @appointment.service.price.to_d
   else
     0.to_d
   end %>

<% total_duration = if has_multiple_service_records
     booked_services.sum { |item| item.duration.to_i }
   elsif @appointment.service
     @appointment.service.duration.to_i
   else
     0
   end %>

<% formatted_duration =
  if total_duration < 60
    pluralize(total_duration, "minute")
  else
    "#{pluralize(total_duration / 60, 'hour')}#{" #{pluralize(total_duration % 60, 'minute')}" if total_duration % 60 != 0}"
  end
%>

<div class="min-h-screen bg-slate-50">
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="mb-8">
      <%= link_to appointments_path,
          class: "inline-flex items-center gap-2 text-sm font-medium text-slate-500 transition hover:text-violet-700" do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 19-7-7 7-7"/>
        </svg>
        Back to My Appointments
      <% end %>

      <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-violet-600">
            Booking information
          </p>
          <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-900">
            Appointment Details
          </h1>
          <p class="mt-2 text-sm text-slate-500">
            Review your salon booking and selected services.
          </p>
        </div>

        <span class="inline-flex w-fit items-center rounded-full px-4 py-2 text-sm font-semibold capitalize ring-1 ring-inset <%= status_style %>">
          <%= @appointment.status.humanize %>
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

      <!-- Main Appointment Details -->
      <div class="space-y-6 lg:col-span-2">

        <!-- Salon and Services Card -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-100 p-6 sm:p-8">
            <div class="flex items-start gap-4">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-violet-100 text-violet-700">
                <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 21v-2a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/>
                </svg>
              </div>

              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-slate-500">Salon</p>
                <h2 class="mt-1 break-words text-xl font-bold text-slate-900">
                  <%= @appointment.salon.name %>
                </h2>

                <% if @appointment.salon.respond_to?(:address) && @appointment.salon.address.present? %>
                  <p class="mt-1 text-sm text-slate-500">
                    <%= @appointment.salon.address %>
                  </p>
                <% end %>
              </div>
            </div>
          </div>

          <div class="p-6 sm:p-8">
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">

              <!-- Selected Services -->
              <div class="flex items-start gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-violet-50 text-violet-600">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16"/>
                  </svg>
                </div>

                <div class="min-w-0 flex-1">
                  <p class="text-sm text-slate-500">Selected Services</p>

                  <ol class="mt-1 list-decimal space-y-1 pl-4 font-bold text-slate-900">
                    <% if has_multiple_service_records %>
                      <% booked_services.each do |item| %>
                        <li class="break-words"><%= item.service.name %></li>
                      <% end %>
                    <% elsif @appointment.service %>
                      <li class="break-words"><%= @appointment.service.name %></li>
                    <% else %>
                      <li>Service unavailable</li>
                    <% end %>
                  </ol>
                </div>
              </div>

              <!-- Total Price -->
              <div class="flex items-start gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-2 0-3 1-3 2s1 2 3 2 3 1 3 2-1 2-3 2m0-10V6m0 12v-2m8-4a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z"/>
                  </svg>
                </div>

                <div>
                  <p class="text-sm text-slate-500">Total Price</p>
                  <p class="mt-1 text-xl font-bold text-emerald-700">
                    <%= number_to_currency(total_price, unit: "₹", precision: 2) %>
                  </p>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- Appointment Date and Time -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
          <h3 class="text-lg font-bold text-slate-900">Appointment Schedule</h3>

          <div class="mt-5 grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div class="flex items-start gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z"/>
                </svg>
              </div>

              <div>
                <p class="text-sm text-slate-500">Date</p>
                <p class="mt-1 font-semibold text-slate-900">
                  <%= @appointment.appointment_at.strftime("%A, %d %B %Y") %>
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6v6l4 2m5-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                </svg>
              </div>

              <div>
                <p class="text-sm text-slate-500">Time</p>
                <p class="mt-1 font-semibold text-slate-900">
                  <%= @appointment.appointment_at.strftime("%I:%M %p") %>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Additional Notes -->
        <% if @appointment.notes.present? %>
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <div class="flex items-start gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>
                </svg>
              </div>

              <div class="min-w-0 flex-1">
                <h3 class="font-bold text-slate-900">Additional Notes</h3>
                <p class="mt-2 whitespace-pre-line break-words text-sm leading-6 text-slate-600">
                  <%= @appointment.notes %>
                </p>
              </div>
            </div>
          </div>
        <% end %>

      </div>

      <!-- Booking Summary Sidebar -->
      <aside class="space-y-6">
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="border-b border-slate-100 bg-slate-50 px-6 py-5">
            <h3 class="font-bold text-slate-900">Booking Summary</h3>
          </div>

          <div class="space-y-5 p-6">

            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                Booking Reference
              </p>
              <p class="mt-2 break-all font-mono text-sm font-bold text-slate-900">
                #<%= @appointment.id.to_s.rjust(6, "0") %>
              </p>
            </div>

            <div class="border-t border-slate-100 pt-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                Booking Status
              </p>
              <span class="mt-2 inline-flex items-center rounded-full px-3 py-1.5 text-sm font-semibold capitalize ring-1 ring-inset <%= status_style %>">
                <%= @appointment.status.humanize %>
              </span>
            </div>

            <div class="border-t border-slate-100 pt-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                Total Duration
              </p>
              <p class="mt-2 font-semibold text-slate-900">
                <%= formatted_duration %>
              </p>
            </div>

            <div class="border-t border-slate-100 pt-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                Total Price
              </p>
              <p class="mt-2 text-2xl font-bold text-violet-700">
                <%= number_to_currency(total_price, unit: "₹", precision: 2) %>
              </p>
            </div>

            <div class="border-t border-slate-100 pt-5">
              <%= link_to appointments_path,
                  class: "inline-flex w-full items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" do %>
                Back to My Appointments
              <% end %>
            </div>

          </div>
        </div>
      </aside>

    </div>
  </div>
</div>