
<div class="mx-auto max-w-4xl p-6">
  <h1 class="mb-6 text-2xl font-bold">My Appointments</h1>

  <% if @appointments.any? %>
    <% @appointments.each do |appointment| %>
      <div class="mb-4 rounded-lg border p-4">
        <h2 class="text-xl font-semibold">
          <%= appointment.salon.name %>
        </h2>

        <p class="mt-1">Service: <%= appointment.service.name %></p>
        <p>Price: ₹<%= number_with_precision(appointment.service.price, precision: 2) %></p>
        <p>Date: <%= appointment.appointment_at.strftime("%d %b %Y, %I:%M %p") %></p>
        <p>Status: <%= appointment.status.capitalize %></p>

        <%= link_to "View Details", appointment_path(appointment),
            class: "mt-3 inline-block text-blue-600" %>

        <% if appointment.status == "pending" %>
          <%= button_to "Cancel Appointment",
              cancel_appointment_path(appointment),
              method: :patch,
              form: { data: { turbo_confirm: "Cancel this appointment?" } },
              class: "mt-3 text-red-600" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p>You have not booked any appointments yet.</p>
    <%= link_to "Find Salons", search_salons_path,
        class: "mt-3 inline-block text-blue-600" %>
  <% end %>
</div>
