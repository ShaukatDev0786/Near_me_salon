<div class="min-h-screen bg-slate-50">
  <!-- Page Header -->
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-5 py-10 sm:px-8 sm:py-12">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="mb-3 flex items-center gap-2 text-sm font-semibold text-violet-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="17" rx="2" stroke-width="1.8"/>
              <path stroke-linecap="round" stroke-width="1.8" d="M16 2v4M8 2v4M3 10h18"/>
            </svg>
            YOUR BOOKINGS
          </div>

          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
            My Appointments
          </h1>

          <p class="mt-2 text-sm leading-6 text-slate-500 sm:text-base">
            Manage your bookings and keep track of your salon visits.
          </p>
        </div>

        <%= link_to discover_salons_index_path,
            class: "inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-violet-200 transition hover:-translate-y-0.5 hover:bg-violet-700" do %>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m-7-7h14"/>
          </svg>
          Book an Appointment
        <% end %>
      </div>
    </div>
  </section>

  <!-- Appointment Summary -->
  <section class="mx-auto max-w-7xl px-5 pt-8 sm:px-8">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between">
          <p class="text-sm font-medium text-slate-500">Total Appointments</p>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-violet-50 text-violet-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="17" rx="2" stroke-width="1.8"/>
              <path stroke-linecap="round" stroke-width="1.8" d="M16 2v4M8 2v4M3 10h18"/>
            </svg>
          </span>
        </div>
        <p class="mt-3 text-3xl font-extrabold text-slate-900"><%= @appointments.size %></p>
        <p class="mt-1 text-xs text-slate-400">All your bookings</p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between">
          <p class="text-sm font-medium text-slate-500">Confirmed</p>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 12 4 4L19 6"/>
            </svg>
          </span>
        </div>
        <p class="mt-3 text-3xl font-extrabold text-slate-900">
          <%= @appointments.count { |appointment| appointment.status == "confirmed" } %>
        </p>
        <p class="mt-1 text-xs text-slate-400">Ready for your visit</p>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between">
          <p class="text-sm font-medium text-slate-500">Pending</p>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="9" stroke-width="1.8"/>
              <path stroke-linecap="round" stroke-width="1.8" d="M12 7v5l3 2"/>
            </svg>
          </span>
        </div>
        <p class="mt-3 text-3xl font-extrabold text-slate-900">
          <%= @appointments.count { |appointment| appointment.status == "pending" } %>
        </p>
        <p class="mt-1 text-xs text-slate-400">Awaiting confirmation</p>
      </div>
    </div>
  </section>

  <!-- Appointment List -->
  <section class="mx-auto max-w-7xl px-5 py-10 sm:px-8 sm:py-12">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-slate-900 sm:text-2xl">Your Bookings</h2>
        <p class="mt-1 text-sm text-slate-500">View the details and status of each appointment.</p>
      </div>
      <span class="hidden rounded-full bg-slate-200/70 px-3 py-1.5 text-xs font-semibold text-slate-600 sm:inline-flex">
        <%= pluralize(@appointments.size, "booking") %>
      </span>
    </div>

    <% if @appointments.any? %>
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
        <% @appointments.each do |appointment| %>
          <% status_style = case appointment.status
             when "confirmed"
               "bg-emerald-50 text-emerald-700 ring-emerald-600/20"
             when "pending"
               "bg-amber-50 text-amber-700 ring-amber-600/20"
             when "cancelled"
               "bg-red-50 text-red-700 ring-red-600/20"
             else
               "bg-slate-100 text-slate-700 ring-slate-500/20"
             end %>

          <article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-violet-200 hover:shadow-xl hover:shadow-violet-100/50">
            <div class="h-1 bg-gradient-to-r from-violet-500 via-purple-500 to-fuchsia-500"></div>

            <div class="p-5 sm:p-6">
              <!-- Salon and Status -->
              <div class="flex items-start justify-between gap-4">
                <div class="flex min-w-0 items-center gap-3">
                  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-violet-100 to-fuchsia-100 text-violet-700">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 21h16M5 21V7l7-4 7 4v14M9 10h1m4 0h1m-6 4h1m4 0h1m-5 7v-4h2v4"/>
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <h3 class="break-words text-lg font-bold text-slate-900 group-hover:text-violet-700">
                      <%= appointment.salon.name %>
                    </h3>
                    <p class="mt-1 text-sm text-slate-500">Salon appointment</p>
                  </div>
                </div>

                <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-bold capitalize ring-1 ring-inset <%= status_style %>">
                  <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
                  <%= appointment.status %>
                </span>
              </div>

              <!-- Booking Details -->
              <div class="mt-6 grid grid-cols-1 gap-4 rounded-xl bg-slate-50 p-4 sm:grid-cols-2">
                <div class="flex items-start gap-3">
                  <span class="mt-0.5 text-violet-500">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                  </span>
                  <div class="min-w-0">
                    <p class="text-xs font-medium text-slate-500">Service</p>
                    <p class="mt-1 break-words text-sm font-semibold text-slate-800">
                      <%= appointment.service.name %>
                    </p>
                  </div>
                </div>

                <div class="flex items-start gap-3">
                  <span class="mt-0.5 text-violet-500">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-2.2 0-4 1-4 2.5S9.8 13 12 13s4 1 4 2.5S14.2 18 12 18m0-12v2m0 10v2m8-8a8 8 0 11-16 0 8 8 0 0116 0z"/>
                    </svg>
                  </span>
                  <div>
                    <p class="text-xs font-medium text-slate-500">Price</p>
                    <p class="mt-1 text-sm font-bold text-slate-900">
                      <%= number_to_currency(appointment.service.price, unit: "₹", precision: 2) %>
                    </p>
                  </div>
                </div>

                <div class="flex items-start gap-3 sm:col-span-2">
                  <span class="mt-0.5 text-violet-500">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <rect x="3" y="4" width="18" height="17" rx="2" stroke-width="1.8"/>
                      <path stroke-linecap="round" stroke-width="1.8" d="M16 2v4M8 2v4M3 10h18"/>
                    </svg>
                  </span>
                  <div>
                    <p class="text-xs font-medium text-slate-500">Date and Time</p>
                    <p class="mt-1 text-sm font-semibold text-slate-800">
                      <%= appointment.appointment_at.strftime("%d %b %Y, %I:%M %p") %>
                    </p>
                  </div>
                </div>
              </div>

              <!-- Actions -->
              <div class="mt-5 flex items-center justify-between gap-3">
                <p class="text-xs text-slate-400">
                  Booking #<%= appointment.id %>
                </p>

                <%= link_to appointment_path(appointment),
                    class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-violet-600 focus:outline-none focus:ring-4 focus:ring-violet-100" do %>
                  View Details
                  <svg class="h-4 w-4 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6"/>
                  </svg>
                <% end %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center sm:px-12">
        <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-violet-50 text-violet-600">
          <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="17" rx="2" stroke-width="1.8"/>
            <path stroke-linecap="round" stroke-width="1.8" d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
        </div>

        <h3 class="mt-6 text-xl font-bold text-slate-900">No appointments yet</h3>
        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
          Your next salon visit is waiting. Explore salons near you and book a service that suits you.
        </p>

        <%= link_to discover_salons_index_path,
            class: "mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-violet-200 transition hover:bg-violet-700" do %>
          Explore Salons
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6"/>
          </svg>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
