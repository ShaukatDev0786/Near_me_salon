<%= form_with(model: [@salon, @service]) do |form| %>
  <% if @service.errors.any? %>
    <div class="services-card">
      <h3 class="services-card-title">
        Please correct the following errors:
      </h3>

      <ul>
        <% @service.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="services-field">
    <%= form.label :name, "Service Name", class: "services-label" %>
    <%= form.text_field :name, class: "services-input", required: true %>
  </div>

  <div class="services-field">
    <%= form.label :description, "Description", class: "services-label" %>
    <%= form.text_area :description, class: "services-input", rows: 3 %>
  </div>

  <div class="services-field">
    <%= form.label :price, "Price (₹)", class: "services-label" %>
    <%= form.number_field :price, class: "services-input",
          min: 0, step: "0.01", required: true %>
  </div>

  <div class="services-field">
    <%= form.label :duration, "Duration (minutes)", class: "services-label" %>
    <%= form.number_field :duration, class: "services-input",
          min: 1, step: 1, required: true %>
  </div>

  <div class="services-checkbox-row">
    <%= form.check_box :active, class: "services-checkbox" %>
    <%= form.label :active, "Available for booking" %>
  </div>

  <div class="services-actions">
    <%= form.submit(
      @service.persisted? ? "Update Service" : "Create Service",
      class: "services-button"
    ) %>

    <%= link_to "Back to Services",
      salon_services_path(@salon),
      class: "services-link"
    %>
  </div>
<% end %>
