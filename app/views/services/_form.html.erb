<%= form_with model: [@salon, service], class: "space-y-4" do |form| %>
  <% if service.errors.any? %>
    <div class="rounded border border-red-300 p-3 text-red-700">
      <h2>Please correct these errors:</h2>
      <ul class="list-disc pl-5">
        <% service.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Service Name" %>
    <%= form.text_field :name, required: true,
        class: "w-full rounded border p-2" %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description,
        class: "w-full rounded border p-2" %>
  </div>

  <div>
    <%= form.label :price, "Price (₹)" %>
    <%= form.number_field :price, required: true, min: 0,
        step: "0.01", class: "w-full rounded border p-2" %>
  </div>

  <div>
    <%= form.label :duration, "Duration (minutes)" %>
    <%= form.number_field :duration, required: true, min: 1,
        step: 1, class: "w-full rounded border p-2" %>
  </div>

  <div>
    <%= form.label :active, "Available for booking" %>
    <%= form.check_box :active %>
  </div>

  <%= form.submit class: "rounded bg-blue-600 px-4 py-2 text-white" %>
<% end %>
