<div class="services-page">
  <div class="services-container">
    <div class="services-list-header">
      <div>
        <h1 class="services-heading">Services</h1>
        <p class="services-subheading">
          <%= @salon.name %>
        </p>
      </div>

      <%= link_to "Add Service",
        new_salon_service_path(@salon),
        class: "services-button" %>
    </div>

    <% if @services.any? %>
      <% @services.each do |service| %>
        <article class="services-card">
          <div class="services-list-header">
            <div>
              <h2 class="services-card-title"><%= service.name %></h2>

              <% if service.description.present? %>
                <p class="services-card-description">
                  <%= service.description %>
                </p>
              <% end %>
            </div>

            <div class="services-card-actions">
              <%= link_to "Edit",
                edit_salon_service_path(@salon, service),
                class: "services-link" %>

              <%= link_to "Delete",
                salon_service_path(@salon, service),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure you want to delete this service?"
                },
                class: "services-danger-link" %>
            </div>
          </div>

          <div class="services-card-details">
            <span><strong>Price:</strong> <%= number_to_currency(service.price, unit: "₹") %></span>
            <span><strong>Duration:</strong> <%= service.duration %> minutes</span>

            <span>
              <strong>Availability:</strong>
              <% if service.active? %>
                <span class="services-status services-status-active">Active</span>
              <% else %>
                <span class="services-status services-status-inactive">Inactive</span>
              <% end %>
            </span>
          </div>
        </article>
      <% end %>
    <% else %>
      <div class="services-form-card">
        <h2 class="services-card-title">No services added yet</h2>
        <p class="services-card-description">
          Add your first service so customers can see what your salon offers.
        </p>

        <%= link_to "Add Your First Service",
          new_salon_service_path(@salon),
          class: "services-button" %>
      </div>
    <% end %>

    <%= link_to "Back to My Salons",
      salons_path,
      class: "services-link services-back-link" %>
  </div>
</div>
