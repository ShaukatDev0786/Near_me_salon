<h1>Appointment Cancelled</h1>

<p>Hello <%= @customer.name %>,</p>

<p>We're writing to inform you that your appointment has been cancelled.</p>

<h2>Appointment Details</h2>

<ul>
  <li>
    <strong>Salon:</strong>
    <%= @salon.name %>
  </li>
  <li>
    <strong>Service:</strong>
    <%= @appointment.booked_services.map(&:name).presence&.join(", ") || @appointment.service.name %>
  </li>
  <li>
    <strong>Date and Time:</strong>
    <%= @appointment.appointment_at.strftime("%d %B %Y at %I:%M %p") %>
  </li>
  <li>
    <strong>Status:</strong>
    <%= @appointment.status.humanize %>
  </li>
</ul>

<p>If you would like another appointment, please visit NearMe Salon to book again.</p>

<p>Thank you for your understanding.</p>

<p>NearMe Salon Team</p>
