<div class="auth-page">
  <div class="auth-card">
    <p class="auth-brand">NearMe Salon</p>

    <h1 class="auth-title">Welcome Back!</h1>
    <p class="auth-subtitle">
      Log in to find salons and manage your appointments.
    </p>

    <% if resource.errors.any? %>
      <div class="auth-error" role="alert">
        <ul>
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_for(resource,
        as: resource_name,
        url: session_path(resource_name)) do |f| %>

      <div class="auth-field">
        <%= f.label :email, class: "auth-label" %>
        <div class="auth-input-wrap">
          <svg class="auth-field-icon" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.8"
              aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"/>
            <path d="m3 7 9 6 9-6"/>
          </svg>
          <%= f.email_field :email, autofocus: true,
              autocomplete: "email",
              placeholder: "you@example.com",
              class: "auth-input auth-input-with-icon" %>
        </div>
      </div>

      <div class="auth-field">
        <%= f.label :password, class: "auth-label" %>
        <div class="auth-input-wrap">
          <svg class="auth-field-icon" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.8"
              aria-hidden="true">
            <rect x="4" y="10" width="16" height="11" rx="2"/>
            <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
          </svg>
          <%= f.password_field :password,
              autocomplete: "current-password",
              placeholder: "Enter your password",
              class: "auth-input auth-input-with-icon" %>
        </div>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="auth-checkbox-row">
          <%= f.check_box :remember_me, class: "auth-checkbox" %>
          <%= f.label :remember_me, "Remember me" %>
        </div>
      <% end %>

      <%= f.submit "Log in", class: "auth-button" %>
    <% end %>

    <div class="auth-links">
      <% if devise_mapping.recoverable? %>
        <%= link_to "Forgot your password?",
            new_password_path(resource_name),
            class: "auth-link" %>
      <% end %>

      <% if devise_mapping.registerable? %>
        <%= link_to "Create an account",
            new_registration_path(resource_name),
            class: "auth-link" %>
      <% end %>
    </div>

    <div class="auth-footer">
      Find your style. Discover your neighborhood salon.
    </div>
  </div>
</div>
