
<div class="mx-auto max-w-5xl p-6">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold">Manage Staff</h1>

    <%= link_to "Add Staff Member",
                new_salon_owner_staff_member_path,
                class: "rounded-lg bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" %>
  </div>

  <% if @staff_members.any? %>
    <div class="overflow-x-auto rounded-lg border">
      <table class="w-full text-left">
        <thead class="bg-gray-100">
          <tr>
            <th class="p-3">Name</th>
            <th class="p-3">Phone</th>
            <th class="p-3">Status</th>
            <th class="p-3">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @staff_members.each do |staff| %>
            <tr class="border-t">
              <td class="p-3"><%= staff.name %></td>
              <td class="p-3"><%= staff.phone.presence || "—" %></td>
              <td class="p-3"><%= staff.active? ? "Active" : "Inactive" %></td>
              <td class="p-3">
                <div class="flex flex-wrap gap-3">
                  <%= link_to "Edit", edit_salon_owner_staff_member_path(staff),
                              class: "text-blue-600 hover:underline" %>

                  <%= link_to "Working Hours",
                              working_hours_salon_owner_staff_member_path(staff),
                              class: "text-green-700 hover:underline" %>

                  <% if staff.active? %>
                    <%= button_to "Deactivate",
                                  salon_owner_staff_member_path(staff),
                                  method: :delete,
                                  class: "text-red-600 hover:underline",
                                  form: { data: { turbo_confirm: "Deactivate this staff member?" } } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="rounded-lg border border-dashed p-8 text-center text-gray-600">
      No staff members have been added yet.
    </p>
  <% end %>
</div>
