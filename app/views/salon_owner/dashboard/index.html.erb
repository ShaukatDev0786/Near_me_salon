<div class="min-h-screen bg-slate-50 px-4 py-8 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">

    <% owner_salons = current_user.salons %>
    <% salon_ids = owner_salons.select(:id) %>
    <% owner_services = Service.where(salon_id: salon_ids) %>
    <% owner_appointments = Appointment.where(salon_id: salon_ids) %>

    <!-- Salon Approval Status -->
    <% if owner_salons.any? %>
      <div class="mb-8 space-y-4">
        <% owner_salons.each do |salon| %>
          <% if salon.approval_status == "pending" %>
            <div class="rounded-xl border border-amber-200 bg-amber-50 p-5">
              <div class="flex items-start gap-3">
                <span class="text-2xl">⏳</span>
                <div>
                  <h2 class="font-semibold text-amber-900">
                    Pending Approval: <%= salon.name %>
                  </h2>
                  <p class="mt-1 text-sm leading-6 text-amber-800">
                    Your salon registration is waiting for admin approval.
                    Customers cannot see or book appointments at your salon until it is approved.
                  </p>
                </div>
              </div>
            </div>
          <% elsif salon.approval_status == "rejected" %>
            <div class="rounded-xl border border-red-200 bg-red-50 p-5">
              <div class="flex items-start gap-3">
                <span class="text-2xl">⚠️</span>
                <div>
                  <h2 class="font-semibold text-red-900">
                    Salon Not Approved: <%= salon.name %>
                  </h2>
                  <p class="mt-1 text-sm leading-6 text-red-800">
                    Your salon has not been approved. Please contact the administrator
                    for more information.
                  </p>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <!-- Dashboard Header -->
    <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
      <div>
        <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-violet-600">
          Salon Management
        </p>

        <h1 class="text-3xl font-bold tracking-tight text-slate-900">
          Salon Owner Dashboard
        </h1>

        <p class="mt-2 text-sm text-slate-500">
          Welcome, <%= current_user.email %>! Here's how your business is doing.
        </p>
      </div>

      <%= link_to "Manage Appointments",
          salon_owner_appointments_path,
          class: "inline-flex items-center justify-center rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-violet-700 focus:outline-none focus:ring-4 focus:ring-violet-200 active:scale-95" %>
    </div>

    <!-- Statistics -->
    <div class="mb-8 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">

      <%= link_to salons_path, class: "rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md" do %>
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-slate-500">My Salons</p>
            <p class="mt-3 text-3xl font-bold text-slate-900">
              <%= owner_salons.count %>
            </p>
          </div>
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-100 text-2xl">
            🏪
          </div>
        </div>
        <p class="mt-4 text-sm text-slate-500">Your registered salon locations</p>
      <% end %>

      <%= link_to salons_path, class: "rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md" do %>
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-slate-500">Total Services</p>
            <p class="mt-3 text-3xl font-bold text-slate-900">
              <%= owner_services.count %>
            </p>
          </div>
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-fuchsia-100 text-2xl">
            ✂️
          </div>
        </div>
        <p class="mt-4 text-sm text-slate-500">Services listed at your salons</p>
      <% end %>

      <%= link_to salon_owner_appointments_path, class: "rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md" do %>
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-slate-500">Total Appointments</p>
            <p class="mt-3 text-3xl font-bold text-slate-900">
              <%= owner_appointments.count %>
            </p>
          </div>
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-100 text-2xl">
            📅
          </div>
        </div>
        <p class="mt-4 text-sm text-slate-500">Bookings across your salons</p>
      <% end %>

      <%= link_to salon_owner_appointments_path, class: "rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md" do %>
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-slate-500">Pending Bookings</p>
            <p class="mt-3 text-3xl font-bold text-amber-600">
              <%= owner_appointments.where(status: "pending").count %>
            </p>
          </div>
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-100 text-2xl">
            ⏳
          </div>
        </div>
        <p class="mt-4 text-sm text-slate-500">Appointments needing attention</p>
      <% end %>

    </div>

    <!-- Quick Actions -->
    <div class="mb-4">
      <h2 class="text-xl font-bold text-slate-900">Quick Actions</h2>
      <p class="mt-1 text-sm text-slate-500">
        Manage your salons, services, and customer bookings.
      </p>
    </div>

    <div class="mb-8 grid grid-cols-1 gap-5 md:grid-cols-3">

      <!-- My Salons -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-violet-100 text-2xl">
          🏬
        </div>

        <h3 class="text-lg font-bold text-slate-900">My Salons</h3>
        <p class="mt-2 min-h-12 text-sm leading-6 text-slate-500">
          Add a new salon, update business information, or manage existing locations.
        </p>

        <%= link_to "Manage My Salons",
            salons_path,
            class: "mt-5 inline-flex w-full items-center justify-center rounded-lg border border-violet-200 px-4 py-2.5 text-sm font-semibold text-violet-700 transition hover:bg-violet-50 focus:outline-none focus:ring-4 focus:ring-violet-100 active:scale-95" %>
      </div>

      <!-- Services -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-fuchsia-100 text-2xl">
          ✂️
        </div>

        <h3 class="text-lg font-bold text-slate-900">Manage Services</h3>
        <p class="mt-2 min-h-12 text-sm leading-6 text-slate-500">
          Maintain service names, prices, durations, and booking availability.
        </p>

        <%= link_to "Manage Services", salons_path, class: "mt-5 inline-flex w-full items-center justify-center rounded-lg border border-violet-200 px-4 py-2.5 text-sm font-semibold text-violet-700 transition hover:bg-violet-50 focus:outline-none focus:ring-4 focus:ring-violet-100 active:scale-95" %>
      </div>

      <!-- Appointments -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
        <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-100 text-2xl">
          📋
        </div>

        <h3 class="text-lg font-bold text-slate-900">Manage Appointments</h3>
        <p class="mt-2 min-h-12 text-sm leading-6 text-slate-500">
          Review customer bookings and confirm or cancel appointments.
        </p>

        <%= link_to "View Appointments",
            salon_owner_appointments_path,
            class: "mt-5 inline-flex w-full items-center justify-center rounded-lg bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-violet-700 focus:outline-none focus:ring-4 focus:ring-violet-200 active:scale-95" %>
      </div>

       <!-- Staff Management Card -->
       <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
        <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-100 text-2xl">
          <div class="flex items-center gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-violet-100">
              <svg xmlns="http://www.w3.org/2000/svg"
                  class="h-6 w-6 text-violet-600"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M17 20h5v-2a3 3 0 00-5.196-2.04M17 20H7m10 0v-2c0-.7-.15-1.36-.42-1.96M7 20H2v-2a3 3 0 015.196-2.04M7 20v-2c0-.7.15-1.36.42-1.96m0 0a5 5 0 019.16 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
          </div>
        </div>

        <h3 class="text-lg font-bold text-slate-900">Staff Management</h3>
        <p class="mt-2 min-h-12 text-sm leading-6 text-slate-500">
          Manage staff members and working hours.
        </p>

        <%= link_to "View Staff",
            salon_owner_staff_members_path,
            class: "mt-5 inline-flex w-full items-center justify-center rounded-lg bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-violet-700 focus:outline-none focus:ring-4 focus:ring-violet-200 active:scale-95" %>
      </div>
    </div>

    <!-- Recent Appointments -->
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex flex-col justify-between gap-2 border-b border-slate-200 px-6 py-5 sm:flex-row sm:items-center">
        <div>
          <h2 class="text-xl font-bold text-slate-900">Recent Appointments</h2>
          <p class="mt-1 text-sm text-slate-500">
            The latest customer bookings for your salons.
          </p>
        </div>

        <%= link_to "View All",
            salon_owner_appointments_path,
            class: "text-sm font-semibold text-violet-700 hover:text-violet-900 focus:outline-none focus:ring-2 focus:ring-violet-300 rounded" %>
      </div>

      <% recent_appointments = owner_appointments.includes(:user, :salon, :service).order(created_at: :desc).limit(5) %>

      <% if recent_appointments.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Customer</th>
                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Salon</th>
                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Service</th>
                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Date &amp; Time</th>
                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">Status</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-slate-100">
              <% recent_appointments.each do |appointment| %>
                <tr class="transition hover:bg-slate-50">
                  <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-slate-900">
                    <%= appointment.user.email %>
                  </td>

                  <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-600">
                    <%= appointment.salon.name %>
                  </td>

                  <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-600">
                    <%= appointment.service.name %>
                  </td>

                  <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-600">
                    <%= appointment.appointment_at.strftime("%d %b %Y, %I:%M %p") %>
                  </td>

                  <td class="whitespace-nowrap px-6 py-4 text-sm">
                    <% status_classes = {
                      "pending" => "bg-amber-100 text-amber-800",
                      "confirmed" => "bg-emerald-100 text-emerald-800",
                      "cancelled" => "bg-red-100 text-red-800"
                    } %>

                    <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= status_classes.fetch(appointment.status, 'bg-slate-100 text-slate-700') %>">
                      <%= appointment.status.humanize %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-6 py-12 text-center">
          <div class="mb-3 text-4xl">📅</div>
          <h3 class="font-semibold text-slate-900">No appointments yet</h3>
          <p class="mt-1 text-sm text-slate-500">
            New bookings will appear here when customers book your services.
          </p>
        </div>
      <% end %>
    </div>

    <div class="mt-8 text-center text-sm text-slate-400">
      NearMe Salon · Salon Owner Portal
    </div>

  </div>
</div>
