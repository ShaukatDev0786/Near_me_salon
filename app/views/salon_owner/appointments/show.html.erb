<div class="min-h-screen bg-slate-50 px-4 py-8 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl">

    <!-- Header -->
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-wider text-violet-600">Salon Management</p>
        <h1 class="mt-1 break-words text-2xl font-bold text-slate-900">Appointment Details</h1>
        <p class="mt-1 text-sm text-slate-500">Review the booking and manage its status, attendance, and payment.</p>
      </div>

      <%= link_to salon_owner_appointments_path,
        class: "inline-flex shrink-0 items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m15 19-7-7 7-7"/>
        </svg>
        Back to Appointments
      <% end %>
    </div>

    <% booked_services = @appointment.appointment_services.includes(:service) %>
    <% has_service_records = booked_services.any? %>

    <% total_price = if has_service_records
         booked_services.sum { |item| item.price.to_d }
       elsif @appointment.service
         @appointment.service.price.to_d
       else
         0.to_d
       end %>

    <% total_duration = if has_service_records
         booked_services.sum { |item| item.duration.to_i }
       elsif @appointment.service
         @appointment.service.duration.to_i
       else
         0
       end %>

    <% formatted_duration = if total_duration < 60
         pluralize(total_duration, "minute")
       else
         "#{pluralize(total_duration / 60, 'hour')}#{" #{pluralize(total_duration % 60, 'minute')}" if total_duration % 60 != 0}"
       end %>

    <% status_colors = {
      "pending" => "bg-amber-100 text-amber-800",
      "confirmed" => "bg-emerald-100 text-emerald-800",
      "completed" => "bg-blue-100 text-blue-800",
      "cancelled" => "bg-red-100 text-red-800"
    } %>

    <% attendance_colors = {
      "attended" => "bg-emerald-100 text-emerald-800",
      "no_show" => "bg-red-100 text-red-800",
      "not_marked" => "bg-slate-100 text-slate-700"
    } %>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

      <!-- Appointment Header -->
      <div class="flex min-w-0 flex-col gap-4 border-b border-slate-100 bg-slate-50/70 p-5 sm:flex-row sm:items-start sm:justify-between sm:p-6">
        <div class="flex min-w-0 items-start gap-3">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-violet-100 text-violet-700">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="5" width="18" height="16" rx="2" stroke-width="1.8"/>
              <path stroke-linecap="round" stroke-width="1.8" d="M16 3v4M8 3v4M3 10h18"/>
            </svg>
          </div>
          <div class="min-w-0">
            <h2 class="break-words text-xl font-bold leading-7 text-slate-900 [overflow-wrap:anywhere]"><%= @appointment.salon.name %></h2>
            <p class="mt-1 break-words text-sm text-slate-500">Booking reference #<%= @appointment.id.to_s.rjust(6, "0") %></p>
            <p class="mt-2 flex items-start gap-2 break-words text-sm text-slate-700">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" stroke-width="1.8"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 7v5l3 2"/>
              </svg>
              <%= @appointment.appointment_at.strftime("%A, %d %B %Y, %I:%M %p") %>
            </p>
          </div>
        </div>

        <div class="flex shrink-0 flex-wrap gap-2 sm:justify-end">
          <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold <%= status_colors.fetch(@appointment.status, 'bg-slate-100 text-slate-700') %>">
            <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
            <%= @appointment.status.humanize %>
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold <%= @appointment.approval_status == 'approved' ? 'bg-emerald-100 text-emerald-800' : @appointment.approval_status == 'rejected' ? 'bg-red-100 text-red-800' : 'bg-amber-100 text-amber-800' %>">
            <svg class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 12 4 4L19 6"/>
            </svg>
            Approval: <%= @appointment.approval_status.humanize %>
          </span>
        </div>
      </div>

      <div class="space-y-7 p-5 sm:p-6">

        <!-- Booked Services -->
        <section class="min-w-0">
          <div class="flex items-center gap-2">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-violet-50 text-violet-600">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
            </div>
            <div class="min-w-0">
              <h3 class="font-bold text-slate-900">Booked Services</h3>
              <p class="text-sm text-slate-500">Services included in this appointment.</p>
            </div>
          </div>

          <div class="mt-4 divide-y divide-slate-100 rounded-xl border border-slate-200">
            <% if has_service_records %>
              <% booked_services.each_with_index do |item, index| %>
                <div class="flex min-w-0 flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between">
                  <div class="flex min-w-0 items-start gap-3">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-violet-50 text-sm font-bold text-violet-700"><%= index + 1 %></span>
                    <div class="min-w-0 flex-1">
                      <p class="break-words font-semibold leading-6 text-slate-900 [overflow-wrap:anywhere]"><%= item.service.name %></p>
                      <p class="mt-1 flex items-center gap-1.5 text-sm text-slate-500">
                        <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <circle cx="12" cy="12" r="9" stroke-width="1.8"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 7v5l3 2"/>
                        </svg>
                        <%= pluralize(item.duration.to_i, "minute") %>
                      </p>
                    </div>
                  </div>
                  <p class="shrink-0 break-words pl-11 font-bold text-slate-900 sm:pl-0"><%= number_to_currency(item.price, unit: "₹", precision: 2) %></p>
                </div>
              <% end %>
            <% elsif @appointment.service %>
              <div class="flex min-w-0 flex-col gap-2 p-4 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                  <p class="break-words font-semibold leading-6 text-slate-900 [overflow-wrap:anywhere]"><%= @appointment.service.name %></p>
                  <p class="mt-1 text-sm text-slate-500"><%= pluralize(@appointment.service.duration.to_i, "minute") %></p>
                </div>
                <p class="font-bold text-slate-900"><%= number_to_currency(total_price, unit: "₹", precision: 2) %></p>
              </div>
            <% else %>
              <p class="p-4 text-sm text-slate-500">No service details are available.</p>
            <% end %>
          </div>

          <!-- Totals -->
          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div class="flex min-w-0 items-center gap-3 rounded-xl bg-slate-50 p-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" stroke-width="1.8"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 7v5l3 2"/>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-sm text-slate-500">Total Duration</p>
                <p class="mt-1 break-words font-semibold text-slate-900"><%= formatted_duration %></p>
              </div>
            </div>

            <div class="flex min-w-0 items-center gap-3 rounded-xl bg-violet-50 p-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white text-violet-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="2" y="5" width="20" height="14" rx="2" stroke-width="1.8"/>
                  <path stroke-linecap="round" stroke-width="1.8" d="M2 10h20"/>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-sm text-slate-500">Total Price</p>
                <p class="mt-1 break-words text-xl font-bold text-violet-700"><%= number_to_currency(total_price, unit: "₹", precision: 2) %></p>
              </div>
            </div>
          </div>
        </section>

        <!-- Customer Information -->
        <section class="border-t border-slate-100 pt-6">
          <div class="flex items-center gap-2">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="8" r="4" stroke-width="1.8"/>
                <path stroke-linecap="round" stroke-width="1.8" d="M4 21a8 8 0 0 1 16 0"/>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900">Customer Information</h3>
          </div>

          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="flex min-w-0 items-start gap-3 rounded-lg border border-slate-100 p-3">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="8" r="4" stroke-width="1.8"/>
                <path stroke-linecap="round" stroke-width="1.8" d="M4 21a8 8 0 0 1 16 0"/>
              </svg>
              <div class="min-w-0">
                <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Customer Name</p>
                <p class="mt-1 break-words text-sm font-medium text-slate-900 [overflow-wrap:anywhere]">
                  <%= @appointment.user.respond_to?(:name) && @appointment.user.name.present? ? @appointment.user.name : @appointment.user.email %>
                </p>
              </div>
            </div>

            <div class="flex min-w-0 items-start gap-3 rounded-lg border border-slate-100 p-3">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" stroke-width="1.8"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m3 7 9 6 9-6"/>
              </svg>
              <div class="min-w-0">
                <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Email Address</p>
                <p class="mt-1 break-words text-sm font-medium text-slate-900 [overflow-wrap:anywhere]"><%= @appointment.user.email %></p>
              </div>
            </div>

            <% if @appointment.user.respond_to?(:phone_number) && @appointment.user.phone_number.present? %>
              <div class="flex min-w-0 items-start gap-3 rounded-lg border border-slate-100 p-3">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 3h4l2 5-3 2a15 15 0 0 0 6 6l2-3 5 2v4c0 1-1 2-2 2C10 20 4 14 3 5c0-1 1-2 2-2Z"/>
                </svg>
                <div class="min-w-0">
                  <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Phone Number</p>
                  <p class="mt-1 break-words text-sm font-medium text-slate-900"><%= @appointment.user.phone_number %></p>
                </div>
              </div>
            <% end %>
          </div>
        </section>

        <!-- Appointment Notes -->
        <% if @appointment.notes.present? %>
          <section class="border-t border-slate-100 pt-6">
            <div class="flex items-center gap-2">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-50 text-amber-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>
                </svg>
              </div>
              <h3 class="font-bold text-slate-900">Appointment Notes</h3>
            </div>
            <p class="mt-3 whitespace-pre-wrap break-words rounded-xl bg-slate-50 p-4 text-sm leading-6 text-slate-700 [overflow-wrap:anywhere]"><%= @appointment.notes %></p>
          </section>
        <% end %>

        <!-- Manage Appointment -->
        <section class="border-t border-slate-100 pt-6">
          <div class="flex items-center gap-2">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-violet-50 text-violet-600">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8V4H4v8h4m4-4 4 4m-4-4-4 4m4-4v12h8v-8"/>
              </svg>
            </div>
            <h3 class="font-bold text-slate-900">Manage Appointment</h3>
          </div>

          <div class="mt-4 flex flex-wrap gap-2">
            <% if @appointment.status == "pending" && @appointment.approval_status == "approved" %>
              <%= button_to confirm_salon_owner_appointment_path(@appointment),
                method: :patch,
                class: "inline-flex min-h-10 items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700" do %>
                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 12 4 4L19 6"/>
                </svg>
                Confirm Appointment
              <% end %>
            <% end %>

            <% if @appointment.status == "confirmed" && @appointment.approval_status == "approved" %>
              <%= button_to complete_salon_owner_appointment_path(@appointment),
                method: :patch,
                class: "inline-flex min-h-10 items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700" do %>
                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 12 4 4L19 6"/>
                </svg>
                Mark as Completed
              <% end %>
            <% end %>

            <% if %w[pending confirmed].include?(@appointment.status) %>
              <%= button_to cancel_salon_owner_appointment_path(@appointment),
                method: :patch,
                form: { data: { turbo_confirm: "Are you sure you want to cancel this appointment?" } },
                class: "inline-flex min-h-10 items-center justify-center gap-2 rounded-lg border border-red-200 bg-white px-4 py-2 text-sm font-semibold text-red-600 transition hover:bg-red-50" do %>
                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 6l12 12M18 6 6 18"/>
                </svg>
                Cancel Appointment
              <% end %>
            <% end %>
          </div>
        </section>

        <!-- Attendance -->
        <% unless @appointment.status == "cancelled" %>
          <section class="border-t border-slate-100 pt-6">
            <div class="flex items-center gap-2">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="9" cy="8" r="4" stroke-width="1.8"/>
                  <path stroke-linecap="round" stroke-width="1.8" d="M2 21a7 7 0 0 1 14 0m2-11 2 2 3-4"/>
                </svg>
              </div>
              <div class="min-w-0">
                <h3 class="font-bold text-slate-900">Customer Attendance</h3>
                <p class="mt-1 text-sm text-slate-500">Record whether the customer attended or did not show up.</p>
              </div>
            </div>

            <div class="mt-3">
              <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold <%= attendance_colors.fetch(@appointment.attendance_status, 'bg-slate-100 text-slate-700') %>">
                <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
                Current: <%= @appointment.attendance_status.humanize %>
              </span>
            </div>

            <%= form_with url: update_attendance_salon_owner_appointment_path(@appointment),
              method: :patch,
              class: "mt-3 flex min-w-0 flex-col gap-2 sm:flex-row" do |form| %>

              <%= form.select :attendance_status,
                options_for_select(
                  [["Not marked", "not_marked"], ["Attended", "attended"], ["No-show / Not attended", "no_show"]],
                  @appointment.attendance_status
                ),
                {},
                class: "h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-100 sm:flex-1" %>

              <%= form.button type: "submit",
                class: "inline-flex min-h-11 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700 sm:w-48" do %>
                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 12 4 4L19 6"/>
                </svg>
                Save Attendance
              <% end %>
            <% end %>
          </section>

          <!-- Payment -->
          <section class="border-t border-slate-100 pt-6">
            <div class="flex items-center gap-2">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="2" y="5" width="20" height="14" rx="2" stroke-width="1.8"/>
                  <path stroke-linecap="round" stroke-width="1.8" d="M2 10h20"/>
                </svg>
              </div>
              <div class="min-w-0">
                <h3 class="font-bold text-slate-900">Payment Management</h3>
                <p class="mt-1 text-sm text-slate-500">Record payment status and payment method.</p>
              </div>
            </div>

            <div class="mt-3 rounded-xl bg-slate-50 p-4">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                <span class="text-sm text-slate-500">Appointment total</span>
                <span class="text-lg font-bold text-violet-700"><%= number_to_currency(total_price, unit: "₹", precision: 2) %></span>
              </div>
              <div class="mt-1 flex flex-wrap items-center gap-2 text-sm">
                <span class="text-slate-500">Current payment status:</span>
                <span class="font-semibold text-slate-700"><%= @appointment.payment_status.humanize %></span>
              </div>
            </div>

            <%= form_with url: record_payment_salon_owner_appointment_path(@appointment),
              method: :patch,
              class: "mt-3 grid min-w-0 grid-cols-1 gap-3 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]" do |form| %>

              <div class="min-w-0">
                <%= form.label :payment_status, "Payment Status", class: "mb-1 block text-xs font-medium text-slate-600" %>
                <%= form.select :payment_status,
                  options_for_select(
                    [["Unpaid", "unpaid"], ["Paid", "paid"], ["Refunded", "refunded"]],
                    @appointment.payment_status
                  ),
                  {},
                  class: "h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-100" %>
              </div>

              <div class="min-w-0">
                <%= form.label :payment_method, "Payment Method", class: "mb-1 block text-xs font-medium text-slate-600" %>
                <%= form.select :payment_method,
                  options_for_select(
                    [["Cash", "cash"], ["UPI", "upi"], ["Card", "card"], ["Bank Transfer", "bank_transfer"]],
                    @appointment.payment_method
                  ),
                  { include_blank: "Select payment method" },
                  class: "h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-100" %>
              </div>

              <div class="flex items-end">
                <%= form.button type: "submit",
                  class: "inline-flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-lg bg-emerald-600 px-5 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700 lg:w-auto" do %>
                  <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 12 4 4L19 6"/>
                  </svg>
                  Save Payment
                <% end %>
              </div>
            <% end %>
          </section>
        <% end %>

      </div>
    </div>
  </div>
</div>
