
<div class="mx-auto max-w-2xl p-6">
  <h1 class="mb-6 text-2xl font-bold">Appointment Details</h1>

  <p><strong>Salon:</strong> <%= @appointment.salon.name %></p>
  <p class="mt-2"><strong>Service:</strong> <%= @appointment.service.name %></p>
  <p class="mt-2"><strong>Customer:</strong> <%= @appointment.user.name %></p>
  <p class="mt-2"><strong>Customer Email:</strong> <%= @appointment.user.email %></p>
  <p class="mt-2"><strong>Customer Phone:</strong> <%= @appointment.user.phone.presence || "Not provided" %></p>

  <p class="mt-2">
    <strong>Date:</strong>
    <%= @appointment.appointment_at.strftime("%d %b %Y, %I:%M %p") %>
  </p>

  <p class="mt-2">
    <strong>Price:</strong>
    ₹<%= number_with_precision(@appointment.service.price, precision: 2) %>
  </p>

  <p class="mt-2">
    <strong>Duration:</strong> <%= @appointment.service.duration %> minutes
  </p>

  <p class="mt-2"><strong>Status:</strong> <%= @appointment.status.capitalize %></p>

  <p class="mt-2">
    <strong>Notes:</strong>
    <%= @appointment.notes.presence || "No notes" %>
  </p>

  <div class="mt-6 flex flex-wrap gap-3">
    <% if @appointment.status == "pending" %>
      <%= button_to "Confirm Appointment",
          confirm_salon_owner_appointment_path(@appointment),
          method: :patch,
          class: "rounded bg-green-600 px-4 py-2 text-white" %>
    <% end %>

    <% if %w[pending confirmed].include?(@appointment.status) %>
      <%= button_to "Cancel Appointment",
          cancel_salon_owner_appointment_path(@appointment),
          method: :patch,
          form: { data: { turbo_confirm: "Cancel this appointment?" } },
          class: "rounded bg-red-600 px-4 py-2 text-white" %>
    <% end %>

    <%= link_to "Back to Appointments",
        salon_owner_appointments_path,
        class: "text-blue-600" %>
  </div>
</div>
