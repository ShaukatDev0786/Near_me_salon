<div class="mx-auto max-w-4xl px-4 py-6 sm:px-6 lg:px-8">

  <!-- Page Header -->
  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-violet-600">
        Salon Management
      </p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">
        Appointment Details
      </h1>
      <p class="mt-1 text-sm text-slate-500">
        Review customer booking information and manage the appointment.
      </p>
    </div>

    <%= link_to "Back to Appointments", salon_owner_appointments_path,
      class: "inline-flex h-10 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-violet-200" %>
  </div>

  <!-- Appointment Card -->
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

    <!-- Card Header -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 bg-slate-50 px-5 py-4">
      <div>
        <h2 class="text-lg font-semibold text-slate-900">
          <%= @appointment.service.name %>
        </h2>
        <p class="mt-1 text-sm text-slate-500">
          <%= @appointment.salon.name %>
        </p>
      </div>

      <% status_colors = {
        "pending" => "bg-amber-100 text-amber-800",
        "confirmed" => "bg-emerald-100 text-emerald-800",
        "completed" => "bg-blue-100 text-blue-800",
        "cancelled" => "bg-red-100 text-red-800"
      } %>

      <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= status_colors.fetch(@appointment.status, 'bg-slate-100 text-slate-700') %>">
        <%= @appointment.status.humanize %>
      </span>
    </div>

    <div class="space-y-5 p-5">

      <!-- Booking Information -->
      <section>
        <h3 class="mb-3 text-sm font-semibold text-slate-900">
          Booking Information
        </h3>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">

          <div class="rounded-lg border border-slate-100 p-3">
            <p class="text-xs font-medium text-slate-500">Appointment Date & Time</p>
            <p class="mt-1 text-sm font-semibold text-slate-900">
              <%= @appointment.appointment_at.strftime("%d %b %Y, %I:%M %p") %>
            </p>
          </div>

          <div class="rounded-lg border border-slate-100 p-3">
            <p class="text-xs font-medium text-slate-500">Service Price</p>
            <p class="mt-1 text-sm font-semibold text-slate-900">
              <%= number_to_currency(@appointment.service.price, unit: "₹") %>
            </p>
          </div>

          <div class="rounded-lg border border-slate-100 p-3">
            <p class="text-xs font-medium text-slate-500">Duration</p>
            <p class="mt-1 text-sm font-semibold text-slate-900">
              <% hours, minutes = @appointment.service.duration.divmod(60) %>
              <%= "#{hours} hour#{'s' unless hours == 1}" if hours.positive? %><%= " " if hours.positive? && minutes.positive? %><%= "#{minutes} minute#{'s' unless minutes == 1}" if minutes.positive? %>
            </p>
          </div>

        </div>
      </section>

      <!-- Customer Information -->
      <section class="border-t border-slate-100 pt-5">
        <h3 class="mb-3 text-sm font-semibold text-slate-900">
          Customer Information
        </h3>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

          <div>
            <p class="text-xs font-medium text-slate-500">Customer Name</p>
            <p class="mt-1 text-sm font-medium text-slate-800">
              <%= @appointment.user.name.presence || "Not provided" %>
            </p>
          </div>

          <div>
            <p class="text-xs font-medium text-slate-500">Email Address</p>
            <p class="mt-1 break-words text-sm font-medium text-slate-800">
              <%= @appointment.user.email %>
            </p>
          </div>

          <div>
            <p class="text-xs font-medium text-slate-500">Phone Number</p>
            <p class="mt-1 text-sm font-medium text-slate-800">
              <%= @appointment.user.phone.presence || "Not provided" %>
            </p>
          </div>

        </div>
      </section>

      <!-- Notes -->
      <section class="border-t border-slate-100 pt-5">
        <h3 class="mb-2 text-sm font-semibold text-slate-900">
          Appointment Notes
        </h3>

        <div class="rounded-lg bg-slate-50 p-3 text-sm text-slate-700">
          <%= @appointment.respond_to?(:notes) && @appointment.notes.present? ? @appointment.notes : "No notes added." %>
        </div>
      </section>

      <!-- Management Actions -->
      <section class="border-t border-slate-100 pt-5">
        <h3 class="mb-3 text-sm font-semibold text-slate-900">
          Manage Appointment
        </h3>

        <div class="flex flex-wrap items-center gap-3">

          <% if @appointment.status == "pending" && @appointment.approval_status == "approved" %>
            <%= button_to "Confirm Appointment",
              confirm_salon_owner_appointment_path(@appointment),
              method: :patch,
              class: "inline-flex h-10 items-center justify-center rounded-lg bg-emerald-600 px-4 text-sm font-semibold text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-200" %>
          <% end %>

          <% if %w[pending confirmed].include?(@appointment.status) %>
            <%= button_to "Cancel Appointment",
              cancel_salon_owner_appointment_path(@appointment),
              method: :patch,
              class: "inline-flex h-10 items-center justify-center rounded-lg bg-red-600 px-4 text-sm font-semibold text-white transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-200",
              form: { data: { turbo_confirm: "Are you sure you want to cancel this appointment?" } } %>
          <% end %>

          <%= link_to "Back to Appointments",
            salon_owner_appointments_path,
            class: "inline-flex h-10 items-center justify-center rounded-lg border border-slate-300 px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>

        </div>
      </section>

    </div>
  </div>
</div>
