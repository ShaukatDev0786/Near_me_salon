<div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8">

  <!-- Page Header -->
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-violet-600">
        Salon Management
      </p>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">
        Salon Appointments
      </h1>
      <p class="mt-1 text-sm text-slate-500">
        Search, review, and manage customer bookings.
      </p>
    </div>

    <%= link_to "Back to Dashboard", salon_owner_dashboard_path,
      class: "inline-flex h-9 items-center justify-center rounded-lg border border-violet-200 px-4 text-sm font-semibold text-violet-700 transition hover:bg-violet-50 focus:outline-none focus:ring-2 focus:ring-violet-200" %>
  </div>

  <!-- Dashboard Statistics -->
  <div class="mb-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
    <% [
      ["Total Appointments", @total_appointments, "All bookings", "text-violet-600"],
      ["Pending Bookings", @pending_appointments, "Awaiting confirmation", "text-amber-600"],
      ["Today's Appointments", @today_appointments, "Scheduled today", "text-blue-600"],
      ["Unpaid Bookings", @unpaid_appointments, "Payment not recorded", "text-red-600"]
    ].each do |label, value, description, color| %>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-medium text-slate-500 sm:text-sm"><%= label %></p>
        <p class="mt-1 text-2xl font-bold <%= color %>"><%= value %></p>
        <p class="mt-1 text-xs text-slate-500"><%= description %></p>
      </div>
    <% end %>
  </div>

  <!-- Search and Filters -->
  <div class="mb-5 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <%= form_with url: salon_owner_appointments_path, method: :get, class: "space-y-4" do |form| %>

      <div>
        <%= form.label :q, "Search appointments", class: "mb-1 block text-sm font-medium text-slate-700" %>
        <%= form.text_field :q,
          value: params[:q],
          placeholder: "Customer, salon, service...",
          class: "h-10 w-full rounded-lg border border-slate-300 px-3 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-100" %>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">

        <div>
          <%= form.label :status, "Appointment Status", class: "mb-1 block text-xs font-medium text-slate-600" %>
          <%= form.select :status,
            options_for_select([["All statuses", ""]] + Appointment::STATUSES.map { |s| [s.humanize, s] }, params[:status]),
            {},
            class: "h-10 w-full rounded-lg border border-slate-300 bg-white px-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-100" %>
        </div>

        <div>
          <%= form.label :approval_status, "Admin Approval", class: "mb-1 block text-xs font-medium text-slate-600" %>
          <%= form.select :approval_status,
            options_for_select([["All approvals", ""]] + Appointment::APPROVAL_STATUSES.map { |s| [s.humanize, s] }, params[:approval_status]),
            {},
            class: "h-10 w-full rounded-lg border border-slate-300 bg-white px-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-100" %>
        </div>

        <div>
          <%= form.label :attendance_status, "Attendance", class: "mb-1 block text-xs font-medium text-slate-600" %>
          <%= form.select :attendance_status,
            options_for_select([["All attendance", ""]] + Appointment::ATTENDANCE_STATUSES.map { |s| [s.humanize, s] }, params[:attendance_status]),
            {},
            class: "h-10 w-full rounded-lg border border-slate-300 bg-white px-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-100" %>
        </div>

        <div>
          <%= form.label :payment_status, "Payment", class: "mb-1 block text-xs font-medium text-slate-600" %>
          <%= form.select :payment_status,
            options_for_select([["All payments", ""]] + Appointment::PAYMENT_STATUSES.map { |s| [s.humanize, s] }, params[:payment_status]),
            {},
            class: "h-10 w-full rounded-lg border border-slate-300 bg-white px-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-100" %>
        </div>

        <div>
          <%= form.label :date_from, "From date", class: "mb-1 block text-xs font-medium text-slate-600" %>
          <%= form.date_field :date_from,
            value: params[:date_from],
            class: "h-10 w-full rounded-lg border border-slate-300 px-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-100" %>
        </div>

        <div>
          <%= form.label :date_to, "To date", class: "mb-1 block text-xs font-medium text-slate-600" %>
          <%= form.date_field :date_to,
            value: params[:date_to],
            class: "h-10 w-full rounded-lg border border-slate-300 px-2 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-100" %>
        </div>

      </div>

      <div class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 pt-3">
        <%= link_to "Reset", salon_owner_appointments_path,
          class: "inline-flex h-10 items-center justify-center rounded-lg border border-slate-300 px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-200" %>

        <%= form.submit "Apply Filters",
          class: "inline-flex h-10 cursor-pointer items-center justify-center rounded-lg bg-violet-600 px-5 text-sm font-semibold text-white transition hover:bg-violet-700 focus:outline-none focus:ring-2 focus:ring-violet-200" %>
      </div>

    <% end %>
  </div>

  <!-- Appointments List -->
  <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">

    <div class="flex flex-col gap-1 border-b border-slate-200 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
      <h2 class="font-semibold text-slate-900">Bookings</h2>
      <p class="text-sm text-slate-500">
        Showing <%= @appointments.size %> appointments on this page.
      </p>
    </div>

    <% if @appointments.any? %>

      <div class="divide-y divide-slate-100">

        <% @appointments.each do |appointment| %>
          <div class="border-b border-slate-100 p-4 last:border-b-0 hover:bg-slate-50/70">

            <!-- Title and Status -->
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-base font-semibold text-slate-900">
                <%= appointment.service.name %>
              </h3>

              <% status_colors = {
                "pending" => "bg-amber-100 text-amber-800",
                "confirmed" => "bg-emerald-100 text-emerald-800",
                "completed" => "bg-blue-100 text-blue-800",
                "cancelled" => "bg-red-100 text-red-800"
              } %>

              <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= status_colors.fetch(appointment.status, 'bg-slate-100 text-slate-700') %>">
                <%= appointment.status.humanize %>
              </span>

              <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= appointment.approval_status == 'approved' ? 'bg-emerald-100 text-emerald-800' : appointment.approval_status == 'rejected' ? 'bg-red-100 text-red-800' : 'bg-amber-100 text-amber-800' %>">
                Approval: <%= appointment.approval_status.humanize %>
              </span>
            </div>

            <!-- Appointment Information -->
            <div class="mt-3 grid grid-cols-2 gap-3 rounded-lg bg-slate-50 p-3 sm:grid-cols-3 xl:grid-cols-5">

              <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Customer</p>
                <p class="mt-1 break-words text-sm text-slate-700"><%= appointment.user.email %></p>
              </div>

              <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Salon</p>
                <p class="mt-1 break-words text-sm text-slate-700"><%= appointment.salon.name %></p>
              </div>

              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Date & Time</p>
                <p class="mt-1 text-sm text-slate-700"><%= appointment.appointment_at.strftime("%d %b %Y, %I:%M %p") %></p>
              </div>

              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Attendance</p>
                <p class="mt-1 text-sm text-slate-700"><%= appointment.attendance_status.humanize %></p>
              </div>

              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Payment</p>
                <p class="mt-1 text-sm text-slate-700">
                  <%= appointment.payment_status.humanize %>
                  <% if appointment.payment_method.present? %>
                    · <%= appointment.payment_method.humanize %>
                  <% end %>
                </p>
                <p class="mt-1 text-sm font-semibold text-slate-900">
                  <%= number_to_currency(appointment.service.price, unit: "₹") %>
                </p>
              </div>

            </div>

            <!-- Booking Actions -->
            <div class="mt-3 flex flex-wrap items-center gap-2">

              <%= link_to "View Details", salon_owner_appointment_path(appointment),
                class: "inline-flex h-9 items-center justify-center rounded-lg border border-violet-200 px-3 text-sm font-semibold text-violet-700 hover:bg-violet-50" %>

              <% if appointment.status == "pending" && appointment.approval_status == "approved" %>
                <%= button_to "Confirm", confirm_salon_owner_appointment_path(appointment),
                  method: :patch,
                  class: "inline-flex h-9 items-center justify-center rounded-lg bg-emerald-600 px-4 text-sm font-semibold text-white hover:bg-emerald-700" %>
              <% end %>

              <% if %w[pending confirmed].include?(appointment.status) %>
                <%= button_to "Cancel", cancel_salon_owner_appointment_path(appointment),
                  method: :patch,
                  class: "inline-flex h-9 items-center justify-center rounded-lg bg-red-600 px-4 text-sm font-semibold text-white hover:bg-red-700",
                  form: { data: { turbo_confirm: "Are you sure you want to cancel this appointment?" } } %>
              <% end %>

            </div>

            <!-- Attendance: only for confirmed or completed appointments -->
            <% if %w[confirmed completed].include?(appointment.status) %>
              <div class="mt-3 rounded-lg border border-slate-200 p-3">
                <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
                  Attendance
                </p>

                <%= form_with url: update_attendance_salon_owner_appointment_path(appointment),
                  method: :patch,
                  class: "flex flex-col gap-2 sm:flex-row sm:items-center" do |form| %>

                  <%= form.select :attendance_status,
                    options_for_select(
                      [["Attended", "attended"], ["No-show", "no_show"]],
                      appointment.attendance_status == "not_marked" ? "attended" : appointment.attendance_status
                    ),
                    {},
                    class: "h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-100 sm:flex-1" %>

                  <%= form.submit "Save Attendance",
                    class: "inline-flex h-10 w-full cursor-pointer items-center justify-center rounded-lg bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-200 sm:w-40" %>

                <% end %>
              </div>
            <% end %>

            <!-- Payment: consistent layout for every appointment -->
            <div class="mt-3 rounded-lg border border-slate-200 p-3">
              <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
                Payment
              </p>

              <%= form_with url: record_payment_salon_owner_appointment_path(appointment),
                method: :patch,
                class: "flex flex-col gap-2 sm:flex-row sm:items-center" do |form| %>

                <%= form.select :payment_status,
                  options_for_select(
                    [["Unpaid", "unpaid"], ["Paid", "paid"], ["Refunded", "refunded"]],
                    appointment.payment_status
                  ),
                  {},
                  class: "h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-100 sm:flex-1" %>

                <%= form.select :payment_method,
                  options_for_select(
                    [["Cash", "cash"], ["UPI", "upi"], ["Card", "card"], ["Bank Transfer", "bank_transfer"]],
                    appointment.payment_method
                  ),
                  { include_blank: "Payment method" },
                  class: "h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-100 sm:flex-1" %>

                <%= form.submit "Save Payment",
                  class: "inline-flex h-10 w-full cursor-pointer items-center justify-center rounded-lg bg-emerald-600 px-4 text-sm font-semibold text-white hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-200 sm:w-40" %>

              <% end %>
            </div>

          </div>
        <% end %>

      </div>

      <!-- Pagination -->
      <div class="border-t border-slate-200 px-4 py-3">
        <%= paginate @appointments %>
      </div>

    <% else %>

      <div class="px-5 py-12 text-center">
        <h3 class="text-base font-semibold text-slate-900">No appointments found</h3>
        <p class="mt-1 text-sm text-slate-500">
          Try changing your search or filters.
        </p>
        <%= link_to "Clear filters", salon_owner_appointments_path,
          class: "mt-3 inline-flex h-9 items-center justify-center rounded-lg border border-slate-300 px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
      </div>

    <% end %>

  </div>

</div>
