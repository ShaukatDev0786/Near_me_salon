<div class="salon-appointments-page">
  <div class="salon-appointments-container">
    <h1 class="salon-appointments-heading">Salon Appointments</h1>

    <p class="salon-appointments-subtitle">
      Review bookings, check appointment details, and manage cancellations.
    </p>

    <% if @appointments.any? %>
      <% @appointments.each do |appointment| %>
        <article class="salon-appointment-card">
          <div class="salon-appointment-top">
            <div class="salon-appointment-main">
              <h2 class="salon-appointment-service">
                <%= appointment.service.name %>
              </h2>

              <div>
                <% status_class = case appointment.status.to_s.downcase
                   when "confirmed" then "salon-status-confirmed"
                   when "cancelled" then "salon-status-cancelled"
                   when "completed" then "salon-status-completed"
                   else "salon-status-pending"
                   end %>

                <span class="salon-appointment-status <%= status_class %>">
                  <%= appointment.status.to_s.humanize %>
                </span>
              </div>
            </div>

            <div class="salon-appointment-actions">
              <%= link_to "View Details",
                appointment_path(appointment),
                class: "salon-appointment-button salon-appointment-view" %>

              <% if %w[pending confirmed].include?(appointment.status.to_s) %>
                <%= button_to "Cancel",
                  cancel_appointment_path(appointment),
                  method: :patch,
                  class: "salon-appointment-button salon-appointment-cancel",
                  form: {
                    data: {
                      turbo_confirm: "Are you sure you want to cancel this appointment?"
                    }
                  } %>
              <% end %>
            </div>
          </div>

          <div class="salon-appointment-info">
            <div class="salon-appointment-info-item">
              <span class="salon-appointment-label">Salon</span>
              <div class="salon-appointment-value">
                <%= appointment.salon.name %>
              </div>
            </div>

            <div class="salon-appointment-info-item">
              <span class="salon-appointment-label">Customer</span>
              <div class="salon-appointment-value">
                <%= appointment.user.email %>
              </div>
            </div>

            <div class="salon-appointment-info-item">
              <span class="salon-appointment-label">Date &amp; Time</span>
              <div class="salon-appointment-value">
                <%= appointment.appointment_at.strftime("%d %b %Y, %I:%M %p") %>
              </div>
            </div>

            <div class="salon-appointment-info-item">
              <span class="salon-appointment-label">Price</span>
              <div class="salon-appointment-value">
                <%= number_to_currency(appointment.service.price, unit: "₹") %>
              </div>
            </div>
          </div>
        </article>
      <% end %>
    <% else %>
      <div class="salon-appointments-empty">
        <h2>No appointments yet</h2>
        <p>New bookings for your salon will appear here.</p>
      </div>
    <% end %>

    <%= link_to "Back to Dashboard",
      salon_owner_dashboard_path,
      class: "salon-appointments-back" %>
  </div>
</div>
