
<div class="min-h-screen bg-gray-50 text-gray-900">
  <header class="border-b border-gray-200 bg-white">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">
      <%= link_to root_path, class: "text-2xl font-bold text-indigo-600" do %>
        NearMe Salon
      <% end %>

      <nav class="flex items-center gap-4">
        <a href="#services" class="text-sm text-gray-600 hover:text-indigo-600">
          Services
        </a>
        <a href="#how-it-works" class="text-sm text-gray-600 hover:text-indigo-600">
          How it works
        </a>
        <a href="#find-salon"
           class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">
          Find a Salon
        </a>
      </nav>
    </div>
  </header>

  <main>
    <section class="mx-auto max-w-7xl px-6 py-20 text-center">
      <p class="mb-4 font-semibold text-indigo-600">
        YOUR STYLE, YOUR NEIGHBORHOOD
      </p>

      <h1 class="mx-auto max-w-3xl text-4xl font-extrabold tracking-tight sm:text-6xl">
        Find the best salon
        <span class="text-indigo-600">near you.</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-gray-600">
        Discover nearby salons, compare services and prices,
        and book your next appointment in just a few clicks.
      </p>

      <div id="find-salon"
           class="mx-auto mt-10 max-w-2xl rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
        <%= form_with url: "#", method: :get, local: true,
                      class: "grid gap-3 sm:grid-cols-[1fr_1fr_auto]" do |form| %>
          <%= form.text_field :location,
                placeholder: "Enter area or pincode",
                class: "min-w-0 rounded-lg border border-gray-300 px-4 py-3 focus:border-indigo-500 focus:outline-none" %>

          <%= form.select :service,
                options_for_select([
                  ["Haircut", "haircut"],
                  ["Beard Trim", "beard_trim"],
                  ["Shaving", "shaving"],
                  ["Hair Colouring", "hair_colouring"]
                ]),
                {},
                class: "min-w-0 rounded-lg border border-gray-300 px-4 py-3 focus:border-indigo-500 focus:outline-none" %>

          <%= form.submit "Search",
                class: "cursor-pointer rounded-lg bg-indigo-600 px-6 py-3 font-semibold text-white hover:bg-indigo-700" %>
        <% end %>

        <p class="mt-3 text-left text-xs text-gray-500">
          Salon search will be connected in the next development phase.
        </p>
      </div>
    </section>

    <section id="services" class="bg-white py-16">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="text-center text-3xl font-bold">Services for your style</h2>
        <p class="mt-3 text-center text-gray-600">
          Choose the service you need.
        </p>

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <% [
            ["Haircut", "A fresh look for every occasion"],
            ["Beard Trim", "Keep your beard sharp and neat"],
            ["Shaving", "Enjoy a clean, classic shave"],
            ["Hair Colouring", "Try a new colour and style"]
          ].each do |name, description| %>
            <div class="rounded-xl border border-gray-200 p-6 transition hover:border-indigo-300 hover:shadow-md">
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-indigo-50 text-xl text-indigo-600">
                ✂
              </div>
              <h3 class="text-lg font-bold"><%= name %></h3>
              <p class="mt-2 text-sm leading-6 text-gray-600"><%= description %></p>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-3xl font-bold">Book in three simple steps</h2>

      <div class="mt-10 grid gap-8 text-center md:grid-cols-3">
        <div class="rounded-xl bg-white p-6 shadow-sm">
          <p class="text-2xl font-bold text-indigo-600">01</p>
          <h3 class="mt-3 font-bold">Find a salon</h3>
          <p class="mt-2 text-sm text-gray-600">Explore salons in your area.</p>
        </div>

        <div class="rounded-xl bg-white p-6 shadow-sm">
          <p class="text-2xl font-bold text-indigo-600">02</p>
          <h3 class="mt-3 font-bold">Choose a time</h3>
          <p class="mt-2 text-sm text-gray-600">Select your service and appointment slot.</p>
        </div>

        <div class="rounded-xl bg-white p-6 shadow-sm">
          <p class="text-2xl font-bold text-indigo-600">03</p>
          <h3 class="mt-3 font-bold">Get confirmed</h3>
          <p class="mt-2 text-sm text-gray-600">Receive your appointment confirmation.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-gray-200 bg-white px-6 py-8 text-center text-sm text-gray-500">
    © <%= Date.current.year %> NearMe Salon. Find your style, book with ease.
  </footer>
</div>
