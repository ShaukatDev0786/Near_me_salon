<div class="min-h-screen bg-gray-50 text-gray-900">
  <main>
    <section class="mx-auto max-w-7xl px-6 py-5 lg:py-6">
      <div class="grid items-center gap-6 lg:grid-cols-2 lg:gap-10">

        <!-- Left side: smaller video -->
        <div class="mx-auto w-full max-w-lg lg:max-w-none">
          <div class="overflow-hidden rounded-2xl bg-gray-200 shadow-lg">
            <%= video_tag "/videos/haircut1.mp4",
                autoplay: true,
                muted: true,
                loop: true,
                playsinline: true,
                controls: true,
                preload: "metadata",
                class: "h-74 w-full object-cover sm:h-82 lg:h-[510px] xl:h-[560px]" %>
          </div>

          <p class="mt-2 text-center text-xs text-gray-500 lg:text-left">
          </p>
        </div>

        <!-- Right side: compact heading and search form -->
        <div class="text-center lg:text-left">
          <p class="mb-2 text-sm font-semibold tracking-wide text-indigo-600">
            YOUR STYLE, YOUR NEIGHBORHOOD
          </p>

          <h1 class="mx-auto max-w-2xl text-3xl font-extrabold tracking-tight sm:text-4xl xl:text-5xl">
            Find the best salon
            <span class="text-indigo-600">near you.</span>
          </h1>

          <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-gray-600 sm:text-base lg:mx-0">
            Discover nearby salons, compare services and prices,
            and book your next appointment in just a few clicks.
          </p>

          <div id="find-salon"
              class="mx-auto mt-5 max-w-xl rounded-xl border border-gray-200 bg-white p-4 text-left shadow-sm lg:mx-0">

            <h2 class="mb-3 text-base font-bold">Find your perfect salon</h2>

            <%= form_with url: search_salons_path, method: :get,
                class: "space-y-3" do |form| %>

              <div>
                <%= form.label :city, "City",
                    class: "mb-1 block text-sm font-medium" %>

                <%= form.text_field :city,
                    placeholder: "e.g. Lucknow",
                    value: params[:city],
                    class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none" %>
              </div>

              <div>
                <%= form.label :pincode, "PIN Code",
                    class: "mb-1 block text-sm font-medium" %>

                <%= form.text_field :pincode,
                    placeholder: "Enter PIN code",
                    value: params[:pincode],
                    maxlength: 6,
                    class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none" %>
              </div>

              <%= form.submit "Search Salons",
                  class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700" %>
            <% end %>

            <p class="mt-2 text-xs text-gray-500">
              Search salons by city or PIN code.
            </p>
          </div>

          <%= link_to "Explore Services",
              root_path(anchor: "services"),
              class: "mt-3 inline-block text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>
        </div>

      </div>
    </section>

    <section id="services" class="bg-white py-16">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="text-center text-3xl font-bold">Services for your style</h2>

        <p class="mt-3 text-center text-gray-600">
          Choose the service you need.
        </p>

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <% [
            ["Haircut", "A fresh look for every occasion"],
            ["Beard Trim", "Keep your beard sharp and neat"],
            ["Shaving", "Enjoy a clean, classic shave"],
            ["Hair Colouring", "Try a new colour and style"]
          ].each do |name, description| %>
            <div class="rounded-xl border border-gray-200 p-6 transition hover:border-indigo-300 hover:shadow-md">
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-indigo-50 text-xl text-indigo-600">
                ✂
              </div>

              <h3 class="text-lg font-bold"><%= name %></h3>

              <p class="mt-2 text-sm leading-6 text-gray-600">
                <%= description %>
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-3xl font-bold">Book in three simple steps</h2>

      <div class="mt-10 grid gap-8 text-center md:grid-cols-3">
        <div class="rounded-xl bg-white p-6 shadow-sm">
          <p class="text-2xl font-bold text-indigo-600">01</p>
          <h3 class="mt-3 font-bold">Find a salon</h3>
          <p class="mt-2 text-sm text-gray-600">
            Explore salons in your area.
          </p>
        </div>

        <div class="rounded-xl bg-white p-6 shadow-sm">
          <p class="text-2xl font-bold text-indigo-600">02</p>
          <h3 class="mt-3 font-bold">Choose a time</h3>
          <p class="mt-2 text-sm text-gray-600">
            Select your service and appointment slot.
          </p>
        </div>

        <div class="rounded-xl bg-white p-6 shadow-sm">
          <p class="text-2xl font-bold text-indigo-600">03</p>
          <h3 class="mt-3 font-bold">Get confirmed</h3>
          <p class="mt-2 text-sm text-gray-600">
            Receive your appointment confirmation.
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-gray-200 bg-white px-6 py-8 text-center text-sm text-gray-500">
    © <%= Date.current.year %> NearMe Salon. Find your style, book with ease.
  </footer>
</div>
